{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@aicabinet/shared-dict": ["../../packages/shared-dict/src/index.ts"],
      "@aicabinet/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@aicabinet/shared-uni": ["../../packages/shared-uni/src"],
      "@aicabinet/shared-uni/*": ["../../packages/shared-uni/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
