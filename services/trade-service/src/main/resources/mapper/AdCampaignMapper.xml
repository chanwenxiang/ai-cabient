<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.AdCampaignMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.AdCampaign">
    <![CDATA[
    SELECT c.* FROM ad_campaign c WHERE c.campaign_id = #{campaignId} FOR UPDATE
    ]]>
  </select>

</mapper>
