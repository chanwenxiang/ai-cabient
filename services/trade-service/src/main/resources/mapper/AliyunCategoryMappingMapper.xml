<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.AliyunCategoryMappingMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.AliyunCategoryMapping">
    <![CDATA[
    SELECT m.* FROM aliyun_category_mapping m WHERE m.category_id = #{categoryId} FOR UPDATE
    ]]>
  </select>

</mapper>
