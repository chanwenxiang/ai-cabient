<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.UserNotifyPrefMapper">

  <select id="findByUserIdAndCategoryForUpdateRaw" resultType="com.aicabinet.trade.domain.UserNotifyPref">
    <![CDATA[
    SELECT p.* FROM user_notify_pref p
    WHERE p.user_id = #{userId} AND p.category = #{category}
    FOR UPDATE
    ]]>
  </select>

</mapper>
