<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.MediaAssetMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.MediaAsset">
    <![CDATA[
    SELECT a.* FROM media_asset a WHERE a.asset_id = #{assetId} FOR UPDATE
    ]]>
  </select>

</mapper>
