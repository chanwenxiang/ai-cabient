<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.WarehouseOutboundMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.WarehouseOutbound">
    <![CDATA[
    SELECT o.* FROM warehouse_outbound o WHERE o.outbound_id = #{outboundId} FOR UPDATE
    ]]>
  </select>

</mapper>
