<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.MerchantOpsConfigMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.MerchantOpsConfig">
    <![CDATA[
    SELECT c.* FROM merchant_ops_config c WHERE c.merchant_id = #{merchantId} FOR UPDATE
    ]]>
  </select>

</mapper>
