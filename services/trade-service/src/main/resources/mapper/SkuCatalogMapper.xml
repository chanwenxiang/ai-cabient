<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SkuCatalogMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SkuCatalog">
    <![CDATA[
    SELECT s.* FROM sku_catalog s WHERE s.sku_id = #{skuId} FOR UPDATE
    ]]>
  </select>

</mapper>
