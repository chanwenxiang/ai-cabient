<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.DataChangeLogMapper">

  <select id="findByChangedAtBetween" resultType="com.aicabinet.trade.domain.DataChangeLog">
    <![CDATA[
    SELECT l.* FROM data_change_log l WHERE l.changed_at >= #{start} AND l.changed_at < #{end}
    ]]>
  </select>
</mapper>
