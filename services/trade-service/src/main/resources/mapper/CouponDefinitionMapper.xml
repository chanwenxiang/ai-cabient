<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.CouponDefinitionMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.CouponDefinition">
    <![CDATA[
    SELECT d.* FROM coupon_definition d WHERE d.coupon_def_id = #{couponDefId} FOR UPDATE
    ]]>
  </select>
</mapper>
