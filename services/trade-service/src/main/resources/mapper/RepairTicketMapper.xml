<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.RepairTicketMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.RepairTicket">
    <![CDATA[
    SELECT t.* FROM repair_ticket t WHERE t.ticket_id = #{ticketId} FOR UPDATE
    ]]>
  </select>

</mapper>
