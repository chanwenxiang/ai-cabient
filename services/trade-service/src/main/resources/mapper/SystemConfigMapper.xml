<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SystemConfigMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SystemConfig">
    <![CDATA[
    SELECT c.* FROM system_config c WHERE c.config_key = #{configKey} FOR UPDATE
    ]]>
  </select>

</mapper>
