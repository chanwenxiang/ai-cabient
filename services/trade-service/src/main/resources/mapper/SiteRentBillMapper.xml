<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SiteRentBillMapper">

  <select id="selectByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SiteRentBill">
    <![CDATA[
    SELECT b.* FROM site_rent_bill b WHERE b.bill_id = #{billId} FOR UPDATE
    ]]>
  </select>

</mapper>
