<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.RiskEventMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.RiskEvent">
    <![CDATA[
    SELECT r.* FROM risk_event r WHERE r.event_id = #{eventId} FOR UPDATE
    ]]>
  </select>

</mapper>
