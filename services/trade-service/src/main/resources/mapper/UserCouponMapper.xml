<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.UserCouponMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.UserCoupon">
    <![CDATA[
    SELECT c.* FROM user_coupon c WHERE c.coupon_id = #{couponId} FOR UPDATE
    ]]>
  </select>

</mapper>
