<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.DeviceSkuPriceMapper">

  <select id="findByDeviceIdAndSkuIdForUpdateRaw" resultType="com.aicabinet.trade.domain.DeviceSkuPrice">
    <![CDATA[
    SELECT p.* FROM device_sku_price p
    WHERE p.device_id = #{deviceId} AND p.sku_id = #{skuId}
    FOR UPDATE
    ]]>
  </select>

</mapper>
