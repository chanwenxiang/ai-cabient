<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SysDictTypeMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SysDictType">
    <![CDATA[
    SELECT t.* FROM sys_dict_type t WHERE t.dict_type = #{dictType} FOR UPDATE
    ]]>
  </select>

</mapper>
