<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.DeviceInfoMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.DeviceInfo">
    <![CDATA[
    SELECT d.* FROM device_info d WHERE d.device_id = #{deviceId} FOR UPDATE
    ]]>
  </select>

</mapper>
