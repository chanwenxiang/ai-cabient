<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SupplierPayableMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SupplierPayable">
    <![CDATA[
    SELECT p.* FROM supplier_payable p WHERE p.payable_id = #{payableId} FOR UPDATE
    ]]>
  </select>

  <select id="findByPurchaseOrderIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SupplierPayable">
    <![CDATA[
    SELECT p.* FROM supplier_payable p WHERE p.purchase_order_id = #{purchaseOrderId} FOR UPDATE
    ]]>
  </select>

</mapper>
