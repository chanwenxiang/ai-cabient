<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.LinePromoTaskMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.LinePromoTask">
    <![CDATA[
    SELECT t.* FROM line_promo_task t WHERE t.task_id = #{taskId} FOR UPDATE
    ]]>
  </select>

</mapper>
