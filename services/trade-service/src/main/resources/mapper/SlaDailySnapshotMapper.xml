<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.SlaDailySnapshotMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.SlaDailySnapshot">
    <![CDATA[
    SELECT s.* FROM sla_daily_snapshot s WHERE s.snapshot_date = #{snapshotDate} FOR UPDATE
    ]]>
  </select>

</mapper>
