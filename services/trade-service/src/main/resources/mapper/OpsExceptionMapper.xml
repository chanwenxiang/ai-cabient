<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.OpsExceptionMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.OpsException">
    <![CDATA[
    SELECT e.* FROM ops_exception e WHERE e.exception_id = #{exceptionId} FOR UPDATE
    ]]>
  </select>

</mapper>
