<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.GroupBuyMapper">

  <select id="findActive" resultType="com.aicabinet.trade.domain.GroupBuy">
    <![CDATA[
    SELECT g.* FROM group_buy g WHERE g.status = 'ACTIVE' AND g.end_time > #{now}
    ]]>
  </select>
</mapper>
