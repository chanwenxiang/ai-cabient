<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.MerchantReplenishmentRequestMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.MerchantReplenishmentRequest">
    <![CDATA[
    SELECT r.* FROM merchant_replenishment_request r WHERE r.request_id = #{requestId} FOR UPDATE
    ]]>
  </select>

</mapper>
