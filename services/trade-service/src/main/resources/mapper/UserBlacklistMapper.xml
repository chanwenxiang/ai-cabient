<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.UserBlacklistMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.UserBlacklist">
    <![CDATA[
    SELECT b.* FROM user_blacklist b WHERE b.user_id = #{userId} FOR UPDATE
    ]]>
  </select>

</mapper>
