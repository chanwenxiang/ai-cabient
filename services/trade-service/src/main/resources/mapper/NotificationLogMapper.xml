<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.NotificationLogMapper">

  <select id="findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.NotificationLog">
    <![CDATA[
    SELECT n.* FROM notification_log n WHERE n.id = #{id} FOR UPDATE
    ]]>
  </select>

</mapper>
