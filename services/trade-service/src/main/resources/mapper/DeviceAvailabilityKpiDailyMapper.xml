<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.DeviceAvailabilityKpiDailyMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.DeviceAvailabilityKpiDaily">
    <![CDATA[
    SELECT k.* FROM device_availability_kpi_daily k WHERE k.kpi_date = #{kpiDate} FOR UPDATE
    ]]>
  </select>

</mapper>
