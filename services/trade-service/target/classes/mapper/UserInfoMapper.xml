<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.UserInfoMapper">

  <select id="nextOperatorUserId" resultType="java.lang.Long">
    SELECT nextval('operator_user_id_seq')
  </select>

  <select id="nextConsumerUserId" resultType="long">
    <![CDATA[
    SELECT COALESCE(MAX(user_id), 10000) + 1
                        FROM user_info
                        WHERE user_id < #{operatorStart}
    ]]>
  </select>
</mapper>
