<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.UserAccountMapper">

  <select id="_findByIdForUpdateRaw" resultType="com.aicabinet.trade.domain.UserAccount">
    <![CDATA[
    SELECT a.* FROM user_account a WHERE a.user_id = #{userId}
    ]]>
  </select>
</mapper>
