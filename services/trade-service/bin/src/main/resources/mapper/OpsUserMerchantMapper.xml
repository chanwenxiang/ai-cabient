<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.OpsUserMerchantMapper">

  <select id="findByMerchantIdIn" resultType="com.aicabinet.trade.domain.OpsUserMerchant">
    SELECT m.* FROM ops_user_merchant m WHERE m.merchantId IN <foreach collection="merchantIds" item="__item" open="(" separator="," close=")">#{__item}</foreach>
  </select>
</mapper>
