<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.FranchiseMapper">

  <select id="findActiveWithValidContract" resultType="com.aicabinet.trade.domain.Franchise">
    <![CDATA[
    SELECT f.* FROM franchise f WHERE f.contract_end_date >= CURRENT_TIMESTAMP AND f.status = 'ACTIVE'
    ]]>
  </select>
</mapper>
