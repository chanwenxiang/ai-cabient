<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.ShoppingSessionMapper">

  <select id="findByStateInAndUpdatedAtAfter" resultType="com.aicabinet.trade.domain.ShoppingSession">
    SELECT s.* FROM shopping_session s
                        WHERE s.state IN <foreach collection="states" item="__item" open="(" separator="," close=")">#{__item}</foreach> AND s.updated_at >= #{since}
  </select>
</mapper>
