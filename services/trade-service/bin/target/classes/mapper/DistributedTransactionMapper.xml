<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicabinet.trade.mapper.DistributedTransactionMapper">

  <select id="findRetryableTransactions" resultType="com.aicabinet.trade.domain.DistributedTransaction">
    <![CDATA[
    SELECT t.* FROM distributed_transaction t WHERE t.status = 'PENDING' AND t.retry_count < t.max_retry
    ]]>
  </select>
</mapper>
