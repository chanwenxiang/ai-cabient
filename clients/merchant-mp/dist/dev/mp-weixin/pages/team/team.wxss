
.page.data-v-4cba8a8b { padding: 24rpx; min-height: 100vh; box-sizing: border-box;
}
.toolbar.data-v-4cba8a8b { display: flex; justify-content: flex-end; margin-bottom: 12rpx;
}
.invite-btn.data-v-4cba8a8b {
  background: #0f766e;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  padding: 0 28rpx;
}
.card.data-v-4cba8a8b {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.06);
}
.state.data-v-4cba8a8b { display: flex; flex-direction: column; align-items: center; gap: 16rpx; color: #64748b;
}
.err.data-v-4cba8a8b { color: #b91c1c;
}
.retry.data-v-4cba8a8b { background: #0f766e; color: #fff; border: none;
}
.row.data-v-4cba8a8b { display: flex; align-items: center; gap: 20rpx;
}
.avatar.data-v-4cba8a8b {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #ccfbf1; color: #0f766e; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.meta.data-v-4cba8a8b { flex: 1; min-width: 0;
}
.name.data-v-4cba8a8b { display: block; font-size: 30rpx; font-weight: 650; color: #134e4a;
}
.sub.data-v-4cba8a8b { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748b;
}
.inactive.data-v-4cba8a8b { display: block; margin-top: 4rpx; font-size: 22rpx; color: #b91c1c;
}
.self-tag.data-v-4cba8a8b, .more.data-v-4cba8a8b {
  font-size: 22rpx; color: #0f766e; background: #ecfdf5;
  padding: 6rpx 12rpx; border-radius: 999rpx; font-weight: 600;
}
.more.data-v-4cba8a8b { background: #f1f5f9; color: #64748b;
}
.empty-btn.data-v-4cba8a8b {
  margin-top: 16rpx; background: #0f766e; color: #fff; border: none; border-radius: 999rpx;
}
.mask.data-v-4cba8a8b {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45);
  display: flex; align-items: flex-end; z-index: 20;
}
.dialog.data-v-4cba8a8b {
  width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 85vh; overflow-y: auto;
}
.dialog-title.data-v-4cba8a8b { display: block; font-size: 32rpx; font-weight: 700; color: #134e4a; margin-bottom: 8rpx;
}
.hint.data-v-4cba8a8b { display: block; font-size: 24rpx; color: #64748b; margin-bottom: 20rpx;
}
.input.data-v-4cba8a8b {
  background: #f8fafc; border-radius: 14rpx; padding: 22rpx 20rpx;
  margin-bottom: 16rpx; font-size: 28rpx;
}
.role-row.data-v-4cba8a8b { display: flex; gap: 12rpx; margin: 8rpx 0 24rpx;
}
.role-row.wrap.data-v-4cba8a8b { flex-wrap: wrap;
}
.role-chip.data-v-4cba8a8b {
  padding: 12rpx 24rpx; border-radius: 999rpx; background: #f1f5f9; color: #64748b; font-size: 26rpx;
}
.role-chip.active.data-v-4cba8a8b { background: #ccfbf1; color: #0f766e; font-weight: 650;
}
.dialog-actions.data-v-4cba8a8b { display: flex; gap: 16rpx;
