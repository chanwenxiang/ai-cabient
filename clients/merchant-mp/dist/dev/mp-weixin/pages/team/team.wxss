.section.data-v-4cba8a8b { margin-bottom: 28rpx;
}
.section-title.data-v-4cba8a8b { display: block; font-size: 26rpx; font-weight: 650; color: #334155; margin-bottom: 12rpx;
}
.btn.data-v-4cba8a8b {
  flex: 1; background: #0f766e; color: #fff; border: none; border-radius: 999rpx; font-size: 28rpx;
}
.btn.block.data-v-4cba8a8b { width: 100%; margin-bottom: 12rpx; flex: none;
}
.btn.ghost.data-v-4cba8a8b { background: #f1f5f9; color: #475569;
}
.btn.danger.data-v-4cba8a8b { background: #b91c1c;
}
