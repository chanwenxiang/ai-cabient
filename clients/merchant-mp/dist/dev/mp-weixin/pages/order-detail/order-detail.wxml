<view class="page-root data-v-48de6e3f"><view wx:if="{{a}}" class="loading data-v-48de6e3f"><text class="data-v-48de6e3f">加载中…</text></view><view wx:elif="{{b}}" class="empty data-v-48de6e3f"><text class="err data-v-48de6e3f">{{c}}</text><button class="retry data-v-48de6e3f" bindtap="{{d}}">重试</button></view><view wx:elif="{{e}}" class="data-v-48de6e3f"><view class="{{['status-bar', 'data-v-48de6e3f', h]}}"><text class="status-title data-v-48de6e3f">{{f}}</text><text class="status-amt data-v-48de6e3f">{{g}}</text></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">商品明细</text><view wx:for="{{i}}" wx:for-item="line" wx:key="d" class="line data-v-48de6e3f"><view class="line-info data-v-48de6e3f"><text class="line-name data-v-48de6e3f">{{line.a}}</text><text class="line-qty data-v-48de6e3f">x{{line.b}}</text></view><text class="line-amt data-v-48de6e3f">{{line.c}}</text></view><view wx:if="{{j}}" class="muted data-v-48de6e3f">无商品明细</view><view wx:if="{{k}}" class="sum-row data-v-48de6e3f"><text class="data-v-48de6e3f">优惠</text><text class="data-v-48de6e3f">-{{l}}</text></view><view class="sum-row strong data-v-48de6e3f"><text class="data-v-48de6e3f">实付</text><text class="data-v-48de6e3f">{{m}}</text></view></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">订单信息</text><view class="info-row data-v-48de6e3f"><text class="lbl data-v-48de6e3f">订单号</text><text class="val mono data-v-48de6e3f">{{n}}</text></view><view class="info-row data-v-48de6e3f"><text class="lbl data-v-48de6e3f">会话</text><text class="val mono data-v-48de6e3f">{{o}}</text></view><view class="info-row data-v-48de6e3f"><text class="lbl data-v-48de6e3f">柜机</text><text class="val mono data-v-48de6e3f">{{p}}</text></view><view class="info-row data-v-48de6e3f"><text class="lbl data-v-48de6e3f">支付方式</text><text class="val data-v-48de6e3f">{{q}}</text></view><view class="info-row data-v-48de6e3f"><text class="lbl data-v-48de6e3f">创建时间</text><text class="val data-v-48de6e3f">{{r}}</text></view></view><view class="actions data-v-48de6e3f"><button wx:if="{{s}}" class="btn-primary data-v-48de6e3f" bindtap="{{t}}">查看柜机</button><button class="btn-outline data-v-48de6e3f" bindtap="{{v}}">相关争议</button></view></view></view>