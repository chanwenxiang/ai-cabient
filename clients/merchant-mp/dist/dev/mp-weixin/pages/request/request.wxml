<view class="page data-v-a2f8b0fb"><view class="tabs data-v-a2f8b0fb"><view class="{{['tab', 'data-v-a2f8b0fb', a && 'active']}}" bindtap="{{b}}">发起要货</view><view class="{{['tab', 'data-v-a2f8b0fb', c && 'active']}}" bindtap="{{d}}">我的申请</view></view><view wx:if="{{e}}" class="panel data-v-a2f8b0fb"><view class="card data-v-a2f8b0fb"><text class="label data-v-a2f8b0fb">目标柜机</text><picker class="data-v-a2f8b0fb" range="{{g}}" value="{{h}}" bindchange="{{i}}"><view class="picker data-v-a2f8b0fb">{{f}}</view></picker><text wx:if="{{j}}" class="hint data-v-a2f8b0fb">当前为常驻柜</text></view><view class="card data-v-a2f8b0fb"><view class="row-between data-v-a2f8b0fb"><text class="label data-v-a2f8b0fb">要货明细</text><text class="hint data-v-a2f8b0fb" bindtap="{{k}}">刷新建议</text></view><view wx:if="{{l}}" class="empty-inline data-v-a2f8b0fb">加载建议中…</view><view wx:elif="{{m}}" class="empty-inline data-v-a2f8b0fb"> 该柜机暂无可要货商品（无绑定货道 SKU） </view><view wx:for="{{n}}" wx:for-item="line" wx:key="m" class="line-row data-v-a2f8b0fb" bindtap="{{line.n}}"><view class="{{['check', 'data-v-a2f8b0fb', line.b && 'on']}}">{{line.a}}</view><view class="line-copy data-v-a2f8b0fb"><text class="sku-name data-v-a2f8b0fb">{{line.c}}</text><text class="sku-meta data-v-a2f8b0fb">{{line.d}} · 库存 {{line.e}}/{{line.f}} <text wx:if="{{line.g}}" class="data-v-a2f8b0fb"> · 建议 {{line.h}}</text></text></view><view class="qty-box data-v-a2f8b0fb" catchtap="{{line.l}}"><text class="qty-btn data-v-a2f8b0fb" bindtap="{{line.i}}">−</text><text class="qty-val data-v-a2f8b0fb">{{line.j}}</text><text class="qty-btn data-v-a2f8b0fb" bindtap="{{line.k}}">+</text></view></view></view><view class="card data-v-a2f8b0fb"><text class="label data-v-a2f8b0fb">备注（可选）</text><input class="input data-v-a2f8b0fb" placeholder="如：周末客流大，优先补可乐" maxlength="80" value="{{o}}" bindinput="{{p}}"/></view><view class="{{['btn-primary', 'data-v-a2f8b0fb', r && 'disabled']}}" bindtap="{{s}}">{{q}}</view><text wx:if="{{t}}" class="err data-v-a2f8b0fb">当前账号无要货权限</text></view><view wx:else class="panel data-v-a2f8b0fb"><view class="filters data-v-a2f8b0fb"><view wx:for="{{v}}" wx:for-item="t" wx:key="b" class="{{['filter', 'data-v-a2f8b0fb', t.c && 'active']}}" bindtap="{{t.d}}">{{t.a}}</view></view><view wx:if="{{w}}" class="empty-inline data-v-a2f8b0fb">加载中…</view><view wx:elif="{{x}}" class="empty-inline err data-v-a2f8b0fb">{{y}}</view><view wx:elif="{{z}}" class="empty-inline data-v-a2f8b0fb">暂无要货申请</view><view wx:for="{{A}}" wx:for-item="req" wx:key="n" class="{{['card', 'req-card', 'data-v-a2f8b0fb', req.o && 'clickable']}}" hover-class="{{req.p}}" bindtap="{{req.q}}"><view class="row-between data-v-a2f8b0fb"><text class="req-id data-v-a2f8b0fb">#{{req.a}}</text><text class="{{['status', 'data-v-a2f8b0fb', req.c]}}">{{req.b}}</text></view><text class="sku-name data-v-a2f8b0fb">{{req.d}}</text><text class="sku-meta data-v-a2f8b0fb">{{req.e}} · {{req.f}}</text><view wx:if="{{req.g}}" class="lines data-v-a2f8b0fb"><text wx:for="{{req.h}}" wx:for-item="l" wx:key="c" class="line-chip data-v-a2f8b0fb">{{l.a}} ×{{l.b}}</text></view><text wx:if="{{req.i}}" class="reject data-v-a2f8b0fb">驳回：{{req.j}}</text><text wx:if="{{req.k}}" class="notes data-v-a2f8b0fb">备注：{{req.l}}</text><view wx:if="{{req.m}}" class="detail-btn data-v-a2f8b0fb">去补货 ›</view></view><text wx:if="{{B}}" class="trunc-hint data-v-a2f8b0fb">已加载 {{C}} 条申请</text></view></view>