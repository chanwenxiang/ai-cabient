
.page.data-v-a2f8b0fb { min-height: 100vh; padding: 16rpx 20rpx 48rpx; background: #f0fdfa;
}
.tabs.data-v-a2f8b0fb { display: flex; gap: 12rpx; margin-bottom: 16rpx;
}
.tab.data-v-a2f8b0fb {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  background: #fff; color: #64748b; font-size: 26rpx; border: 1rpx solid #e2e8f0;
}
.tab.active.data-v-a2f8b0fb { background: #134e4a; color: #fff; border-color: #134e4a; font-weight: 600;
}
.panel.data-v-a2f8b0fb { display: flex; flex-direction: column; gap: 16rpx;
}
.card.data-v-a2f8b0fb {
  background: #fff; border-radius: 16rpx; padding: 22rpx; border: 1rpx solid #e2e8f0;
}
.label.data-v-a2f8b0fb { display: block; font-size: 24rpx; color: #64748b; margin-bottom: 12rpx;
}
.picker.data-v-a2f8b0fb {
  padding: 18rpx 20rpx; border-radius: 12rpx; background: #f8fafc; border: 1rpx solid #e2e8f0;
  font-size: 28rpx; color: #0f172a;
  overflow: hidden;
  max-height: 88rpx;
}
.hint.data-v-a2f8b0fb { font-size: 22rpx; color: #0f766e; margin-top: 10rpx;
}
.row-between.data-v-a2f8b0fb { display: flex; justify-content: space-between; align-items: center;
}
.empty-inline.data-v-a2f8b0fb { padding: 24rpx 0; text-align: center; color: #94a3b8; font-size: 24rpx;
}
.trunc-hint.data-v-a2f8b0fb {
  display: block;
  text-align: center;
  color: #94a3b8;
  font-size: 22rpx;
  padding: 8rpx 0 16rpx;
}
.line-row.data-v-a2f8b0fb {
  display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
}
.line-row.data-v-a2f8b0fb:first-of-type { border-top: none;
}
.check.data-v-a2f8b0fb {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid #cbd5e1;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff;
  flex-shrink: 0;
}
.check.on.data-v-a2f8b0fb { background: #0f766e; border-color: #0f766e;
}
.line-copy.data-v-a2f8b0fb { flex: 1; min-width: 0;
}
.sku-name.data-v-a2f8b0fb { display: block; font-size: 28rpx; font-weight: 600; color: #0f172a;
}
.sku-meta.data-v-a2f8b0fb { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 4rpx;
}
.qty-box.data-v-a2f8b0fb { display: flex; align-items: center; gap: 8rpx;
}
.qty-btn.data-v-a2f8b0fb {
  width: 48rpx; height: 48rpx; border-radius: 12rpx; background: #ecfdf5; color: #0f766e;
  text-align: center; line-height: 48rpx; font-size: 30rpx; font-weight: 600;
}
.qty-val.data-v-a2f8b0fb { min-width: 40rpx; text-align: center; font-size: 28rpx; font-weight: 600;
}
.input.data-v-a2f8b0fb {
  width: 100%; padding: 16rpx 18rpx; border-radius: 12rpx; background: #f8fafc;
  border: 1rpx solid #e2e8f0; font-size: 26rpx; box-sizing: border-box;
}
.btn-primary.data-v-a2f8b0fb {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #134e4a, #0f766e);
  color: #fff;
  border-radius: 44rpx;
  padding: 0;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.22);
}
.btn-primary.data-v-a2f8b0fb::after { border: none;
}
.btn-primary.disabled.data-v-a2f8b0fb { opacity: 0.45;
}
.err.data-v-a2f8b0fb { color: #b91c1c; font-size: 24rpx; text-align: center;
}
.filters.data-v-a2f8b0fb { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 4rpx;
}
.filter.data-v-a2f8b0fb {
  padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff; color: #64748b;
  font-size: 22rpx; border: 1rpx solid #e2e8f0;
}
.filter.active.data-v-a2f8b0fb { background: #ccfbf1; color: #0f766e; border-color: #99f6e4; font-weight: 600;
}
.req-card.data-v-a2f8b0fb { display: flex; flex-direction: column; gap: 8rpx;
}
.req-card.clickable.data-v-a2f8b0fb { cursor: pointer; -webkit-tap-highlight-color: transparent;
}
.req-card-hover.data-v-a2f8b0fb { background: #f8fafc !important;
}
.req-id.data-v-a2f8b0fb { font-size: 22rpx; color: #94a3b8;
}
.status.data-v-a2f8b0fb {
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx;
  background: #fef3c7; color: #92400e;
}
.status.accepted.data-v-a2f8b0fb { background: #dcfce7; color: #166534;
}
.status.rejected.data-v-a2f8b0fb { background: #fee2e2; color: #991b1b;
}
.status.completed.data-v-a2f8b0fb { background: #e0e7ff; color: #3730a3;
}
.lines.data-v-a2f8b0fb { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx;
}
.line-chip.data-v-a2f8b0fb {
  font-size: 22rpx; background: #f0fdfa; color: #0f766e; padding: 6rpx 12rpx; border-radius: 999rpx;
}
.reject.data-v-a2f8b0fb { font-size: 22rpx; color: #b91c1c;
}
.notes.data-v-a2f8b0fb { font-size: 22rpx; color: #64748b;
}
.req-card.clickable .req-id.data-v-a2f8b0fb,
.req-card.clickable .status.data-v-a2f8b0fb,
.req-card.clickable .sku-name.data-v-a2f8b0fb,
.req-card.clickable .sku-meta.data-v-a2f8b0fb,
.req-card.clickable .lines.data-v-a2f8b0fb,
.req-card.clickable .reject.data-v-a2f8b0fb,
.req-card.clickable .notes.data-v-a2f8b0fb,
.req-card.clickable .detail-btn.data-v-a2f8b0fb { pointer-events: none;
}
.detail-btn.data-v-a2f8b0fb {
  margin-top: 12rpx; align-self: flex-start; padding: 12rpx 28rpx; border-radius: 999rpx;
  background: #0f766e; color: #fff; font-size: 24rpx; font-weight: 600;
}
