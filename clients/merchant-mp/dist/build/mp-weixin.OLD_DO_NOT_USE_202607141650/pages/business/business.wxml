<view class="page data-v-b01e59ac"><view class="periods data-v-b01e59ac"><text wx:for="{{a}}" wx:for-item="d" wx:key="b" class="{{['period', 'data-v-b01e59ac', d.c && 'active']}}" bindtap="{{d.d}}">近{{d.a}}天</text></view><view wx:if="{{b}}" class="state data-v-b01e59ac">正在汇总经营数据…</view><view wx:elif="{{c}}" class="state data-v-b01e59ac"><text class="error data-v-b01e59ac">{{d}}</text><button class="retry data-v-b01e59ac" bindtap="{{e}}">重试</button></view><block wx:else><view class="hero data-v-b01e59ac"><text class="hero-label data-v-b01e59ac">经营毛利</text><text class="hero-value data-v-b01e59ac">{{f}}</text><view class="hero-row data-v-b01e59ac"><text class="data-v-b01e59ac">营收 {{g}}</text><text class="data-v-b01e59ac">毛利率 {{h}}</text></view></view><view class="metric-grid data-v-b01e59ac"><view class="metric data-v-b01e59ac"><text class="metric-value data-v-b01e59ac">{{i}}</text><text class="metric-label data-v-b01e59ac">本月已结算</text></view><view class="metric data-v-b01e59ac"><text class="metric-value warn data-v-b01e59ac">{{j}}</text><text class="metric-label data-v-b01e59ac">待结算</text></view><view class="metric data-v-b01e59ac"><text class="metric-value data-v-b01e59ac">{{k}}</text><text class="metric-label data-v-b01e59ac">重点商品</text></view><view class="metric data-v-b01e59ac"><text class="metric-value danger data-v-b01e59ac">{{l}}</text><text class="metric-label data-v-b01e59ac">分账异常</text></view></view><view class="card data-v-b01e59ac"><view class="section-head data-v-b01e59ac"><text class="section-title data-v-b01e59ac">商品经营表现</text><text class="section-sub data-v-b01e59ac">按销售额排序</text></view><view wx:for="{{m}}" wx:for-item="sku" wx:key="f" class="sku-row data-v-b01e59ac"><view class="sku-main data-v-b01e59ac"><text class="sku-name data-v-b01e59ac">{{sku.a}}</text><text class="sku-rec data-v-b01e59ac">毛利 {{sku.b}} · 毛利率 {{sku.c}}</text></view><view class="sku-data data-v-b01e59ac"><text class="data-v-b01e59ac">{{sku.d}} 件</text><text class="sku-money data-v-b01e59ac">{{sku.e}}</text></view></view><view wx:if="{{n}}" class="empty data-v-b01e59ac">暂无可分析的销售数据</view></view><view wx:if="{{o}}" class="risk-card data-v-b01e59ac"><text class="risk-title data-v-b01e59ac">有 {{p}} 笔分账异常</text><text class="risk-desc data-v-b01e59ac">建议联系平台运营核对收款账户和失败原因</text></view></block></view>