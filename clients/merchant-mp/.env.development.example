# Copy to .env.development and adjust for your machine
# 模拟器可用 localhost；真机调试必须改成电脑局域网 IP，例如：
#   VITE_API_BASE_URL=http://192.168.1.8
# 或运行：node scripts/sync-consumer-mp-api.mjs
#
# 真机 Network 全是 (failed) 时：开发者工具勾选「不校验合法域名」；
# 管理员运行 scripts/open-lan-api-firewall.ps1；手机浏览器先测网关是否通。
VITE_API_BASE_URL=http://localhost
# 不要写 VITE_DEMO_PHONE / VITE_DEMO_PASSWORD：开发构建会预填登录并显示「体验账号」
# 商户订阅消息模板（与 compose WECHAT_MERCHANT_SUBSCRIBE_TEMPLATE 对齐；也可由公开配置运行时下发）
VITE_WX_SUBSCRIBE_TMPL_IDS=sLGG1ukNcrUqbSMh8ntkpOq31tBz77QDXpElVgT2v7E
