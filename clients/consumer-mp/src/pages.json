          "style": {
            "navigationBarTitleText": "购物视频",
            "navigationBarBackgroundColor": "#000000",
            "backgroundColor": "#000000",
            "navigationStyle": "custom",
            "backgroundColorTop": "#000000"
          }
        }
      ]
    },
    {
      "root": "pages/dispute",
      "pages": [
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "账单审核",
