/* 自定义 tabBar：悬浮于页面底部（custom 模式页面全屏，无原生占位区域）。
   尺寸对齐原生 tabBar 观感：图标 52rpx + 文案 + 底部安全区。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 990;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}
.tabbar__item {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tabbar__item--hover {
  opacity: 0.72;
}
.tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}
.tabbar__text {
  font-size: 20rpx;
  line-height: 1.2;
}
