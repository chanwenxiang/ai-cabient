# Copy to .env.development and adjust for your machine
# 模拟器可用 localhost；真机调试必须改成电脑局域网 IP，例如：
#   VITE_API_BASE_URL=http://192.168.1.8
# 或运行：node scripts/sync-consumer-mp-api.mjs
#
# 真机 Network 全是 (failed) 时按顺序查：
# 1) 开发者工具 → 详情 → 本地设置 → 勾选「不校验合法域名、web-view、TLS」
# 2) 手机与电脑同一 WiFi（勿用访客网络）
# 3) 管理员运行 scripts/open-lan-api-firewall.ps1
# 4) 手机浏览器打开 http://<局域网IP>/api/v2/auth/server-boot 应能看到 JSON
# 5) 导入 dist/dev/mp-weixin（pnpm --filter @aicabinet/consumer-mp run dev:mp-weixin）
VITE_API_BASE_URL=http://localhost
# Local demo account (dev build only; do not put secrets in production env)
VITE_DEMO_PHONE=13800138000
VITE_DEMO_PASSWORD=123456
