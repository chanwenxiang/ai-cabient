<view class="data-v-020fc815"><view wx:if="{{a}}" class="card data-v-020fc815"><text class="meta data-v-020fc815">加载中…</text></view><view wx:elif="{{b}}" class="card error-card data-v-020fc815"><text class="err data-v-020fc815">{{c}}</text><button class="action-btn data-v-020fc815" hover-class="btn-hover" bindtap="{{d}}">回首页</button><button class="ghost-btn data-v-020fc815" hover-class="btn-hover" bindtap="{{e}}">查看订单</button></view><view wx:elif="{{f}}" class="data-v-020fc815"><view class="{{['success-header', 'data-v-020fc815', j]}}"><text class="success-icon data-v-020fc815">{{g}}</text><text class="success-title data-v-020fc815">{{h}}</text><text class="success-status data-v-020fc815">{{i}}</text></view><view class="card amount-card data-v-020fc815"><text class="amount-label data-v-020fc815">实付金额</text><text class="amount data-v-020fc815">{{k}}</text><text wx:if="{{l}}" class="pay-channel data-v-020fc815">{{m}}</text><text wx:if="{{n}}" class="zero-hint data-v-020fc815">本次未取走商品，未产生扣款</text></view><view wx:if="{{o}}" class="card balance-card data-v-020fc815"><view class="data-v-020fc815"><text class="balance-caption data-v-020fc815">扣款前余额</text><text class="balance-number data-v-020fc815">{{p}}</text></view><text class="balance-arrow data-v-020fc815">→</text><view class="data-v-020fc815"><text class="balance-caption data-v-020fc815">扣款后余额</text><text class="balance-number strong data-v-020fc815">{{q}}</text></view><text class="trial-note data-v-020fc815">本页余额为账户余额展示；免密渠道扣款以微信/支付宝为准</text></view><view class="card data-v-020fc815"><text class="section-title data-v-020fc815">商品明细</text><view wx:if="{{r}}" class="data-v-020fc815"><view wx:for="{{s}}" wx:for-item="line" wx:key="d" class="line data-v-020fc815"><text class="line-name data-v-020fc815">{{line.a}} × {{line.b}}</text><text class="line-amt data-v-020fc815">{{line.c}}</text></view></view><text wx:else class="empty-lines data-v-020fc815">本次未识别到取走商品</text><view wx:if="{{t}}" class="sum-row data-v-020fc815"><text class="sum-label data-v-020fc815">商品合计</text><text class="sum-value data-v-020fc815">{{v}}</text></view><view wx:if="{{w}}" class="sum-row discount data-v-020fc815"><text class="sum-label data-v-020fc815">优惠券抵扣</text><text class="sum-value data-v-020fc815">-{{x}}</text></view><text wx:if="{{y}}" class="coupon-hint data-v-020fc815">已自动选用最优优惠券</text><view wx:if="{{z}}" class="sum-row points data-v-020fc815"><text class="sum-label data-v-020fc815">本次获得积分</text><text class="sum-value data-v-020fc815">+{{A}}</text></view></view><view class="footer-actions data-v-020fc815"><button class="action-btn data-v-020fc815" hover-class="btn-hover" bindtap="{{B}}">继续购物</button><button class="ghost-btn data-v-020fc815" hover-class="btn-hover" bindtap="{{C}}">查看订单</button><view wx:if="{{D}}" class="secondary-actions data-v-020fc815"><text class="secondary-link warn data-v-020fc815" bindtap="{{E}}">账单有问题</text><text wx:if="{{F}}" class="secondary-dot data-v-020fc815">·</text><text wx:if="{{G}}" class="secondary-link danger data-v-020fc815" bindtap="{{H}}">申请退款</text><text class="secondary-dot data-v-020fc815">·</text><text class="secondary-link data-v-020fc815" bindtap="{{I}}">帮助</text></view><text wx:elif="{{J}}" class="dispute-done data-v-020fc815">申诉已提交，请在「订单」查看进度</text><text wx:elif="{{K}}" class="dispute-done data-v-020fc815">退款已完成</text></view></view><view wx:if="{{L}}" class="dispute-mask data-v-020fc815" bindtap="{{aa}}"><view class="dispute-panel data-v-020fc815" catchtap="{{Z}}"><text class="dispute-title data-v-020fc815">{{M}}</text><text class="dispute-sub data-v-020fc815">{{N}}</text><view class="chip-row data-v-020fc815"><text wx:for="{{O}}" wx:for-item="chip" wx:key="b" class="{{['reason-chip', 'data-v-020fc815', chip.c && 'on']}}" bindtap="{{chip.d}}">{{chip.a}}</text></view><block wx:if="{{r0}}"><textarea class="dispute-input data-v-020fc815" maxlength="200" placeholder="例如：我没有拿这个商品 / 数量不对" value="{{P}}" bindinput="{{Q}}"/></block><view class="evidence-block data-v-020fc815"><text class="evidence-label data-v-020fc815">申诉附图（选填）</text><view class="evidence-row data-v-020fc815"><view wx:for="{{R}}" wx:for-item="img" wx:key="d" class="evidence-item data-v-020fc815"><image class="evidence-img data-v-020fc815" src="{{img.a}}" mode="aspectFill"/><text class="evidence-del data-v-020fc815" bindtap="{{img.b}}">×</text><text wx:if="{{img.c}}" class="evidence-uploading data-v-020fc815">上传中</text></view><view wx:if="{{S}}" class="evidence-add data-v-020fc815" bindtap="{{T}}">+</view></view></view><button class="action-btn refund-submit data-v-020fc815" hover-class="btn-hover" loading="{{V}}" disabled="{{W}}" bindtap="{{X}}">{{U}}</button><text class="dispute-cancel data-v-020fc815" bindtap="{{Y}}">取消</text></view></view></view>