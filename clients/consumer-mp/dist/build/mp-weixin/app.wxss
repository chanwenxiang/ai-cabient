page{height:100%;background-color:#f5f7f8;font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,Helvetica,PingFang SC,Microsoft YaHei,sans-serif;font-size:28rpx;color:#14201b;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:24rpx;margin:0 24rpx 16rpx;border:1rpx solid rgba(15,118,110,.06);box-shadow:0 10rpx 32rpx rgba(15,23,42,.055)}.meta{color:#888;font-size:26rpx}button,.btn-primary,.btn-ghost,.menu-cell,.filter-chip,.scan-btn{transition:transform .18s ease,opacity .18s ease,box-shadow .18s ease}button:active,.btn-primary:active,.btn-ghost:active,.menu-cell:active,.filter-chip:active{transform:scale(.985);opacity:.88}@media (min-width: 600px){uni-page-body{width:520px;min-height:calc(100vh - 36px);margin:18px auto;border-radius:28px;overflow:hidden;box-shadow:0 22px 70px rgba(15,23,42,.14)}}
page::after{position:fixed;content:'';left:-1000px;top:-1000px;-webkit-animation:shadow-preload .1s;-webkit-animation-delay:3s;animation:shadow-preload .1s;animation-delay:3s}@-webkit-keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}@keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}