
.page-root.data-v-1c73d2c2 { min-height: 100vh; background: #f7f7f7; padding-bottom: 48rpx;
}
.state.data-v-1c73d2c2 { padding: 120rpx 48rpx; text-align: center;
}
.meta.data-v-1c73d2c2 { color: #888;
}
.err.data-v-1c73d2c2 { display: block; color: #fa5151; margin-bottom: 24rpx;
}
.hero.data-v-1c73d2c2 {
  padding: 48rpx 40rpx 56rpx;
  color: #fff;
  border-radius: 0 0 32rpx 32rpx;
}
.hero.tone-wait.data-v-1c73d2c2 { background: linear-gradient(145deg, #0f766e, #14b8a6);
}
.hero.tone-warn.data-v-1c73d2c2 { background: linear-gradient(145deg, #b45309, #f59e0b);
}
.hero.tone-success.data-v-1c73d2c2 { background: linear-gradient(145deg, #047857, #10b981);
}
.hero-icon.data-v-1c73d2c2 {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255,255,255,.22); display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx;
}
.hero-title.data-v-1c73d2c2 { display: block; font-size: 36rpx; font-weight: 700;
}
.hero-status.data-v-1c73d2c2 { display: block; margin-top: 8rpx; font-size: 26rpx; opacity: .92;
}
.card.data-v-1c73d2c2 {
  margin: 20rpx 24rpx 0; padding: 28rpx; background: #fff; border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .04);
}
.section-title.data-v-1c73d2c2 { display: block; font-size: 30rpx; font-weight: 700; color: #1e293b; margin-bottom: 12rpx;
}
.section-sub.data-v-1c73d2c2 { display: block; font-size: 22rpx; color: #94a3b8; margin-bottom: 12rpx;
}
.evidence-row.data-v-1c73d2c2 { display: flex; flex-wrap: wrap; gap: 16rpx;
}
.evidence-img.data-v-1c73d2c2 { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f1f5f9;
}
.reason.data-v-1c73d2c2 { display: block; font-size: 28rpx; color: #334155; line-height: 1.55; margin-bottom: 16rpx;
}
.info-row.data-v-1c73d2c2 { display: flex; justify-content: space-between; padding: 10rpx 0;
}
.info-label.data-v-1c73d2c2 { font-size: 24rpx; color: #94a3b8;
}
.info-value.data-v-1c73d2c2 { font-size: 24rpx; color: #475569; max-width: 70%; text-align: right;
}
.info-value.mono.data-v-1c73d2c2 { font-family: ui-monospace, monospace; font-size: 22rpx;
}
.line.data-v-1c73d2c2 { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9;
}
.line-name.data-v-1c73d2c2 { color: #1e293b; font-size: 28rpx;
}
.line-amt.data-v-1c73d2c2 { color: #059669; font-weight: 600;
}
.empty-lines.data-v-1c73d2c2 { font-size: 26rpx; color: #94a3b8; padding: 8rpx 0;
}
.bill-row.data-v-1c73d2c2 {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #e2e8f0;
}
.bill-label.data-v-1c73d2c2 { font-size: 28rpx; color: #64748b;
}
.bill-amount.data-v-1c73d2c2 { font-size: 40rpx; font-weight: 800; color: #047857;
}
.actions.data-v-1c73d2c2 { padding: 28rpx 24rpx 8rpx; display: flex; flex-direction: column; gap: 16rpx;
}
.btn-primary.data-v-1c73d2c2, .btn-ghost.data-v-1c73d2c2 {
  margin: 0; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; font-size: 30rpx;
}
.btn-primary.data-v-1c73d2c2 { background: linear-gradient(135deg, #059669, #0d9488); color: #fff; font-weight: 700;
}
.btn-primary.data-v-1c73d2c2::after, .btn-ghost.data-v-1c73d2c2::after { border: none;
}
.btn-ghost.data-v-1c73d2c2 { background: #fff; color: #334155; border: 1rpx solid #e2e8f0;
}
.btn-hover.data-v-1c73d2c2 { opacity: 0.88;
}
.contact-link.data-v-1c73d2c2 {
  display: block;
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: 26rpx;
  color: #64748b;
}
