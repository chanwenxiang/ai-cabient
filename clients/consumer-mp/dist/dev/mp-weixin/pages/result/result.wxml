iew><text class="field-label data-v-d38065ce">申诉说明</text><block wx:if="{{r0}}"><textarea class="dispute-input data-v-d38065ce" maxlength="200" aria-label="申诉说明" placeholder="例如：我没有拿这个商品 / 数量不对…" value="{{P}}" bindinput="{{Q}}"/></block><view class="evidence-block data-v-d38065ce"><text class="evidence-label data-v-d38065ce">申诉附图（选填）</text><view class="evidence-row data-v-d38065ce"><view wx:for="{{R}}" wx:for-item="img" wx:key="e" class="evidence-item data-v-d38065ce"><image class="evidence-img data-v-d38065ce" src="{{img.a}}" mode="aspectFill" aria-label="{{img.b}}"/><text class="evidence-del data-v-d38065ce" role="button" aria-label="删除证据图" bindtap="{{img.c}}">×</text><text wx:if="{{img.d}}" class="evidence-uploading data-v-d38065ce">上传中…</text></view><view wx:if="{{S}}" class="evidence-add data-v-d38065ce" role="button" aria-label="添加证据图" bindtap="{{T}}">+</view></view></view><button class="action-btn refund-submit data-v-d38065ce" hover-class="btn-hover" loading="{{V}}" disabled="{{W}}" bindtap="{{X}}">{{U}}</button><text class="dispute-cancel data-v-d38065ce" bindtap="{{Y}}">取消</text></view></view></view>