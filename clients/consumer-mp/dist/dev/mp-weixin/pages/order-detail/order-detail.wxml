<view class="page-root data-v-48de6e3f"><view wx:if="{{a}}" class="loading data-v-48de6e3f"><text class="data-v-48de6e3f">加载中…</text></view><view wx:elif="{{b}}" class="error data-v-48de6e3f"><text class="data-v-48de6e3f">{{c}}</text></view><view wx:else class="data-v-48de6e3f"><view class="{{['status-bar', 'data-v-48de6e3f', g]}}"><text class="status-icon data-v-48de6e3f">{{d}}</text><view class="status-copy data-v-48de6e3f"><text class="status-title data-v-48de6e3f">{{e}}</text><text class="status-detail data-v-48de6e3f">{{f}}</text></view></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">商品清单</text><view wx:for="{{h}}" wx:for-item="item" wx:key="d" class="item-row data-v-48de6e3f"><view class="item-info data-v-48de6e3f"><text class="item-name data-v-48de6e3f">{{item.a}}</text><text class="item-qty data-v-48de6e3f">x{{item.b}}</text></view><text class="item-price data-v-48de6e3f">¥{{item.c}}</text></view><view class="total-row data-v-48de6e3f"><text class="total-label data-v-48de6e3f">合计</text><text class="total-amount data-v-48de6e3f">¥{{i}}</text></view><view wx:if="{{j}}" class="discount-row data-v-48de6e3f"><text class="discount-label data-v-48de6e3f">优惠券抵扣</text><text class="discount-amount data-v-48de6e3f">-¥{{k}}</text></view></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">支付信息</text><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">支付方式</text><text class="info-value data-v-48de6e3f">{{l}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">扣款时间</text><text class="info-value data-v-48de6e3f">{{m}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">订单编号</text><text class="info-value mono data-v-48de6e3f">{{n}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">设备编号</text><text class="info-value mono data-v-48de6e3f">{{o}}</text></view></view><view class="actions data-v-48de6e3f"><button wx:if="{{p}}" class="btn-outline data-v-48de6e3f" bindtap="{{q}}">查看购物视频</button><button class="btn-outline danger data-v-48de6e3f" bindtap="{{r}}">对账单有疑问</button></view><view class="support data-v-48de6e3f">客服电话: 400-888-0018</view></view></view>