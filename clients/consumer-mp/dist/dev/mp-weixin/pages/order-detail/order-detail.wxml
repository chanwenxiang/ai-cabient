<view class="page-root data-v-48de6e3f"><view wx:if="{{a}}" class="loading data-v-48de6e3f"><text class="data-v-48de6e3f">加载中…</text></view><view wx:elif="{{b}}" class="error data-v-48de6e3f"><text class="data-v-48de6e3f">{{c}}</text><button class="btn-outline data-v-48de6e3f" style="margin-top:24rpx" bindtap="{{d}}">重试</button></view><view wx:else class="data-v-48de6e3f"><view class="{{['status-bar', 'data-v-48de6e3f', h]}}"><text class="status-icon data-v-48de6e3f">{{e}}</text><view class="status-copy data-v-48de6e3f"><text class="status-title data-v-48de6e3f">{{f}}</text><text class="status-detail data-v-48de6e3f">{{g}}</text></view></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">商品清单</text><view wx:for="{{i}}" wx:for-item="item" wx:key="d" class="item-row data-v-48de6e3f"><view class="item-info data-v-48de6e3f"><text class="item-name data-v-48de6e3f">{{item.a}}</text><text class="item-qty data-v-48de6e3f">x{{item.b}}</text></view><text class="item-price data-v-48de6e3f">{{item.c}}</text></view><view wx:if="{{j}}" class="empty-lines data-v-48de6e3f">本次未识别到取走商品</view><view class="total-row data-v-48de6e3f"><text class="total-label data-v-48de6e3f">商品合计</text><text class="total-amount data-v-48de6e3f">{{k}}</text></view><view wx:if="{{l}}" class="discount-row data-v-48de6e3f"><text class="discount-label data-v-48de6e3f">优惠券抵扣</text><text class="discount-amount data-v-48de6e3f">-{{m}}</text></view><view wx:if="{{n}}" class="total-row pay data-v-48de6e3f"><text class="total-label data-v-48de6e3f">实付</text><text class="total-amount data-v-48de6e3f">{{o}}</text></view></view><view class="section data-v-48de6e3f"><text class="section-title data-v-48de6e3f">支付信息</text><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">支付方式</text><text class="info-value data-v-48de6e3f">{{p}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">扣款时间</text><text class="info-value data-v-48de6e3f">{{q}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">订单编号</text><text class="info-value mono data-v-48de6e3f">{{r}}</text></view><view class="info-row data-v-48de6e3f"><text class="info-label data-v-48de6e3f">柜机编号</text><text class="info-value mono data-v-48de6e3f">{{s}}</text></view></view><view class="actions data-v-48de6e3f"><button wx:if="{{t}}" class="btn-primary data-v-48de6e3f" bindtap="{{v}}">再去本柜购物</button><button wx:if="{{w}}" class="btn-outline data-v-48de6e3f" bindtap="{{x}}">查看购物视频</button><button wx:if="{{y}}" class="btn-refund data-v-48de6e3f" disabled="{{A}}" bindtap="{{B}}">{{z}}</button><button wx:if="{{C}}" class="btn-outline danger data-v-48de6e3f" disabled="{{E}}" bindtap="{{F}}">{{D}}</button><button class="btn-outline data-v-48de6e3f" bindtap="{{G}}">帮助与客服</button></view><view class="support data-v-48de6e3f" bindtap="{{I}}">客服电话: {{H}} ›</view></view><view wx:if="{{J}}" class="dispute-mask data-v-48de6e3f" bindtap="{{Y}}"><view class="dispute-panel data-v-48de6e3f" catchtap="{{X}}"><text class="dispute-title data-v-48de6e3f">{{K}}</text><text class="dispute-sub data-v-48de6e3f">{{L}}</text><view class="chip-row data-v-48de6e3f"><text wx:for="{{M}}" wx:for-item="chip" wx:key="b" class="{{['reason-chip', 'data-v-48de6e3f', chip.c && 'on']}}" bindtap="{{chip.d}}">{{chip.a}}</text></view><text class="field-label data-v-48de6e3f">申诉说明</text><block wx:if="{{r0}}"><textarea class="dispute-input data-v-48de6e3f" maxlength="200" aria-label="申诉说明" placeholder="例如：我没有拿这个商品 / 数量不对…" value="{{N}}" bindinput="{{O}}"/></block><view class="evidence-block data-v-48de6e3f"><text class="evidence-label data-v-48de6e3f">申诉附图（选填，最多 5 张）</text><view class="evidence-row data-v-48de6e3f"><view wx:for="{{P}}" wx:for-item="img" wx:key="e" class="evidence-item data-v-48de6e3f"><image class="evidence-img data-v-48de6e3f" src="{{img.a}}" mode="aspectFill" alt="{{img.b}}"/><text class="evidence-del data-v-48de6e3f" role="button" aria-label="删除证据图" bindtap="{{img.c}}">×</text><text wx:if="{{img.d}}" class="evidence-uploading data-v-48de6e3f">上传中…</text></view><view wx:if="{{Q}}" class="evidence-add data-v-48de6e3f" role="button" aria-label="添加证据图" bindtap="{{R}}">+</view></view></view><button class="btn-submit data-v-48de6e3f" loading="{{T}}" disabled="{{U}}" bindtap="{{V}}">{{S}}</button><text class="dispute-cancel data-v-48de6e3f" bindtap="{{W}}">取消</text></view></view></view>