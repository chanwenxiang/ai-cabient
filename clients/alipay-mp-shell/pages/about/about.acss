.page {
  padding: 24rpx;
}
.slogan-card {
  background: linear-gradient(135deg, #0d9488, #0f766e);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
}
.slogan-brand {
  font-size: 22rpx;
  opacity: 0.85;
  letter-spacing: 2rpx;
}
.slogan-title {
  font-size: 38rpx;
  font-weight: 500;
  margin-top: 12rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.7;
  padding: 8rpx 0;
}
.step-no {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ccfbf1;
  color: #0d9488;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.8;
}
.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
}
.label {
  font-size: 24rpx;
  color: #64748b;
  flex-shrink: 0;
}
.val {
  font-size: 24rpx;
  color: #0f172a;
  text-align: right;
}
