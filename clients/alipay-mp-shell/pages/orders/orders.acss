.page {
  padding: 24rpx;
}
.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.head-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #0d9488;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.head-name {
  font-size: 32rpx;
  font-weight: 500;
}
.head-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}
.hint-card,
.foot-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.hint-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.hint-text {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.8;
}
.empty {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 28rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #334155;
}
.empty-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}
.foot-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
}
.foot-label {
  font-size: 24rpx;
  color: #64748b;
  flex-shrink: 0;
}
.foot-value {
  font-size: 24rpx;
  color: #0f172a;
  text-align: right;
}
.nav {
  text-align: center;
  font-size: 26rpx;
  color: #0d9488;
  padding: 24rpx 0 40rpx;
}
