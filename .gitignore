# 旧项目残留（OneDrive 可能从云端恢复，本地忽略）
easygo/
# 嵌套旧副本（与根目录正式工程重复，勿被 IDE/Java LS 扫描）
/ai-cabinet/

# Migration leftovers — not source of truth; keep out of IDE indexing
scripts/_repo_backup/
scripts/*.java.bak

# Maven build output
target/
**/target/

# Eclipse JDT output (not node_modules/**/bin)
services/**/bin/
edge/**/bin/

# Dependencies & package managers
node_modules/
**/node_modules/

# Env / secrets (keep *.example)
.env
.env.*
!.env.example
!**/.env.example
infra/.env

# Local IDE / editor
.idea/
*.iml
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
**/.settings/
*.swp
*.swo
*~

# Gradle / Android local caches
**/.gradle/
**/local.properties
**/build/
!**/src/**/build/

# Playwright / browser test artifacts
.playwright-cli/
**/.playwright-cli/
**/output/
**/playwright-report/
**/test-results/
**/blob-report/

# Python
.venv/
**/__pycache__/
**/.pytest_cache/
*.pyc

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
patch.txt
*.log
)
