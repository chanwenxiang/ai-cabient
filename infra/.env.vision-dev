# vision-service 真实本地 YOLO 识别（开发联调）
# trade-service 仍可保持 AICABINET_MOCK_ENABLED=true
#
# PowerShell:
#   . .\scripts\load-vision-dev-env.ps1
#   cd vision-service; .\.venv\Scripts\python.exe -m uvicorn app.main:app --port 8082

RECOGNIZER_BACKEND=yolo
MOCK_ENABLED=true
VISION_FORCE_REAL=true
YOLO_RECOGNITION_MODE=delta
YOLO_AUTO_DOWNLOAD=false
YOLO_MODEL_PATH=models/retail-os-v2.0.0.pt
YOLO_MODEL_VERSION=retail-os-v2.0.0
YOLO_CONF=0.45
YOLO_REVIEW_CONF=0.72
VISION_API_KEY=dev-vision-key-change-me
VIDEO_CACHE_DIR=cache/videos
