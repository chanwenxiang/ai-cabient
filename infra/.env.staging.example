# 预发 / 无微信进件联调环境模板
# 复制：copy .env.staging.example .env.staging
# 部署：.\scripts\deploy-staging.ps1
# 检查：.\scripts\check-env.ps1 -CheckEnv -EnvFile infra\.env.staging

SPRING_PROFILES_ACTIVE=staging
AICABINET_STAGING_MODE=true
POSTGRES_PASSWORD=CHANGE-ME-staging-postgres-password-32chars
POSTGRES_PORT=15433

JWT_SECRET=CHANGE-ME-staging-jwt-secret-32bytes-minimum!!
INTERNAL_API_KEY=CHANGE-ME-staging-internal-api-key-32b!!

# 关业务 mock；短信走 compose 内 sms-webhook-mock；识别只认端侧上报（云端引擎已退役）
AICABINET_MOCK_ENABLED=false

# 无微信商户凭证：余额结算（真进件后再改）；对账 mock 默认关（审计 P2-20，联调时显式打开）
CHECKOUT_BALANCE_ONLY=true
RECON_MOCK_ENABLED=false
PAYSCORE_ENABLED=false
PAYSCORE_MOCK_ENABLED=false
PAYSCORE_LIVE_CHARGE_ENABLED=false
PAYSCORE_SERVICE_ID=
PAYSCORE_PERMISSION_NOTIFY_URL=
WECHAT_PAY_ENABLED=false

PUBLIC_BASE_URL=http://localhost
CORS_ORIGIN=http://localhost
# deploy-staging / compose.staging 会覆盖为 http://sms-webhook-mock:8099/send
SMS_WEBHOOK_URL=http://localhost:8099/send

REDIS_PASSWORD=change-me-strong-staging

# ── 首次部署初始运营超管（库里没有任何运营账号时才创建；已有账号跳过，不改密码/不提权）──
# 密码只在启动时读取、不写日志；创建成功后可从环境移除
AICABINET_OPS_ADMIN_PHONE=
AICABINET_OPS_ADMIN_PASSWORD=
AICABINET_OPS_ADMIN_NAME=cwx

# ── 将邑接入（识别=端侧；未配 JIANGYI_JWT_SECRET 时设备 token 签发 503 fail-closed）──
# 网关设备 JWT（≥32 字节；吊销=jiangyi_device.token_version+1）
JIANGYI_JWT_SECRET=change-me-to-32-bytes-min-secret
# 商户云入驻/采集/模型（tenantId+secret 找将邑售后取；商户云账号=商户后台账号）
JIANGYI_TENANT_ID=0
JIANGYI_SECRET=
JIANGYI_MERCHANT_MOBILE=
JIANGYI_MERCHANT_PASSWORD=
# 回调公网基址（finishNotifyUrl=<base>/jiangyi/api/gather-finish-notify；须公网可达）
JIANGYI_PUBLIC_BASE_URL=https://your-public-domain
# OSS STS 直传（CB-024）：RAM 子账号只授 AliyunSTSAssumeRoleAccess；直传角色见 DEPLOYMENT_CHECKLIST §3.1
JIANGYI_OSS_ACCESS_KEY_ID=
JIANGYI_OSS_ACCESS_KEY_SECRET=
JIANGYI_OSS_ROLE_ARN=acs:ram::ACCOUNT:role/jiangyivideoupload
JIANGYI_OSS_REGION=cn-shenzhen
JIANGYI_OSS_BUCKET=ai-cabinet-by
JIANGYI_OSS_DIR_NAME=jiangyi-video/
