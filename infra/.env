# AI 开门柜 �?Docker Compose 环境变量模板
# 复制�?infra/.env 后按需修改：cp .env.example .env

# --- 通用 ---
SPRING_PROFILES_ACTIVE=dev
POSTGRES_PASSWORD=aicabinet
# 宿主机映射端口（Windows Hyper-V 常保�?5433�?532，勿改回 5433�?POSTGRES_PORT=15433

# --- 安全（生产必须改为随�?32+ 字符�?--
JWT_SECRET=ai-cabinet-dev-secret-key-32bytes!!
INTERNAL_API_KEY=dev-internal-key-change-me
VISION_API_KEY=staging-vision-api-key-32bytes-minimum

# --- 业务 mock（生产设�?false；本�?MIN-UAT 购物 E2E 需 true �?staging 密钥�?--
AICABINET_MOCK_ENABLED=true
AICABINET_STAGING_MODE=false
VISION_MOCK_ENABLED=true
RECON_MOCK_ENABLED=true

# --- 对外 URL（生产改为真实域名，用于微信支付 notify�?--
PUBLIC_BASE_URL=http://localhost
WECHAT_NOTIFY_URL=http://localhost/api/v2/payment/wechat/notify
CORS_ORIGIN=http://localhost

# --- 微信 API v3（生产必填，dev 可留空走 mock�?--
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_AUTO_FETCH=true
WECHAT_MINIAPP_ID=
WECHAT_MINIAPP_SECRET=

# --- SMS（生产必填）---
SMS_WEBHOOK_URL=

# --- MinIO（compose 内网默认即可�?--
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=cabinet-videos

# --- MQTT（dev 匿名；生产改 ssl:// 并配置账号）---
MQTT_BROKER=tcp://emqx:1883
EMQX_ALLOW_ANONYMOUS=true
# Host 映射端口（Windows Hyper-V 常保�?1822�?921，勿改回 1883/8883/18083�?EMQX_MQTT_PORT=11883
EMQX_MQTT_TLS_PORT=18883
EMQX_DASHBOARD_PORT=28083

# --- vision-service ---
RECOGNIZER_BACKEND=yolo
# Local smoke test: mock vision (set true + rebuild to enable real YOLO)
VISION_INSTALL_ML=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
