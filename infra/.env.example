# AI 开门柜 — Docker Compose 环境变量模板
# 复制为 infra/.env 后按需修改：cp .env.example .env

# --- 通用 ---
SPRING_PROFILES_ACTIVE=dev
POSTGRES_PASSWORD=aicabinet
# 宿主机映射端口（Windows Hyper-V 常保留 5433–5532，勿改回 5433）
POSTGRES_PORT=15433

# --- 安全（生产必须改为随机 32+ 字符）---
JWT_SECRET=ai-cabinet-dev-secret-key-32bytes!!
INTERNAL_API_KEY=dev-internal-key-change-me
VISION_API_KEY=dev-vision-key-change-me

# --- 业务 mock（生产设为 false）---
AICABINET_MOCK_ENABLED=true
AICABINET_STAGING_MODE=false
VISION_MOCK_ENABLED=true
RECON_MOCK_ENABLED=true

# --- 微信分账（本地联调可开 Mock；真机联调关 Mock 并配齐 WECHAT_*）---
PROFIT_SHARING_ENABLED=true
PROFIT_SHARING_MOCK_ENABLED=true
PROFIT_SHARING_RETRY_ENABLED=true
PROFIT_SHARING_RETRY_BATCH_SIZE=20
WECHAT_PAY_ENABLED=false

# --- 对外 URL（生产改为真实域名，用于微信支付 notify）---
PUBLIC_BASE_URL=http://localhost
WECHAT_NOTIFY_URL=http://localhost/api/v2/payment/wechat/notify
ALIPAY_NOTIFY_URL=http://localhost/api/v2/payment/alipay/notify
CORS_ORIGIN=http://localhost

# --- 微信 API v3（生产必填，dev 可留空走 mock）---
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_AUTO_FETCH=true
WECHAT_MINIAPP_ID=
WECHAT_MINIAPP_SECRET=

# --- 支付宝（充值 ALIPAY 渠道；沙箱见 infra/.env.sandbox.example）---
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost/api/v2/payment/alipay/notify

# --- SMS（生产必填）---
SMS_WEBHOOK_URL=

# --- MinIO（compose 内网默认即可）---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=cabinet-videos

# --- MQTT（dev 匿名；生产改 ssl:// 并配置账号）---
MQTT_BROKER=tcp://emqx:1883
EMQX_ALLOW_ANONYMOUS=true
# Host 映射端口（Windows Hyper-V 常保留 1822–1921，勿改回 1883/8883/18083）
EMQX_MQTT_PORT=11883
EMQX_MQTT_TLS_PORT=18883
EMQX_DASHBOARD_PORT=28083

# --- vision-service ---
VISION_MOCK_ENABLED=true
RECOGNIZER_BACKEND=yolo_deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=2000
DEEPSEEK_AUTO_CHARGE=false
AICABINET_GRAVITY_FALLBACK_SETTLE=false
# 真实 YOLO 识别：设为 true 后需 docker compose build vision-service（会安装 ultralytics + torch，体积较大）
VISION_INSTALL_ML=false
# 真实本地视频识别（见 infra/.env.vision-dev）
VISION_FORCE_REAL=false
YOLO_RECOGNITION_MODE=delta
# single_frame | delta（开门前后帧差异，推荐 delta）

OSS_REGION=cn-shanghai
OBJECT_STORAGE_SCHEME=minio
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Windows 可能保留 2947–3046 端口段，因此默认不使用宿主机 3000。
GRAFANA_PORT=13000
