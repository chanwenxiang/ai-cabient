# AI 开门柜 — Docker Compose 环境变量模板
# 复制为 infra/.env 后按需修改：cp .env.example .env

# --- 通用 ---
SPRING_PROFILES_ACTIVE=dev
POSTGRES_PASSWORD=aicabinet
# 宿主机映射端口（Windows Hyper-V 常保留 5433–5532，勿改回 5433）
POSTGRES_PORT=15433

# --- 安全（生产必须改为随机 32+ 字符）---
# 演示默认值仅用于 localhost；勿暴露 full stack 到公网。上线前：scripts/check-env.ps1 -Prod
JWT_SECRET=ai-cabinet-dev-secret-key-32bytes!!
INTERNAL_API_KEY=dev-internal-key-change-me
VISION_API_KEY=dev-vision-key-change-me
# 浏览器会话 Cookie（HttpOnly）：本地 HTTP 无需 Secure，生产 HTTPS 须 AUTH_COOKIE_SECURE=true
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false

# --- 业务 mock（生产设为 false）---
AICABINET_MOCK_ENABLED=true
AICABINET_STAGING_MODE=false
VISION_MOCK_ENABLED=true
RECON_MOCK_ENABLED=true

# --- XXL-JOB（多实例/资金任务；Docker apps 默认 true；本地 IDEA 可改 false）---
XXL_JOB_ENABLED=true
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_MYSQL_PASSWORD=xxljob
# 宿主机端口勿用 18080（与 trade 冲突）
XXL_JOB_ADMIN_PORT=18090
XXL_JOB_EXECUTOR_PORT=9999
# 无微信支付凭证的预发形态：关 mock + 仅余额结算；对账保持 mock；识别需 YOLO 模型后关 VISION_MOCK
# AICABINET_MOCK_ENABLED=false
# CHECKOUT_BALANCE_ONLY=true
# RECON_MOCK_ENABLED=true
# PAYSCORE_ENABLED=false
# PAYSCORE_MOCK_ENABLED=false
# PAYSCORE_LIVE_CHARGE_ENABLED=false
CHECKOUT_BALANCE_ONLY=false
PAYSCORE_ENABLED=false
PAYSCORE_MOCK_ENABLED=true
PAYSCORE_LIVE_CHARGE_ENABLED=false

# --- 微信分账（本地联调可开 Mock；真机联调关 Mock 并配齐 WECHAT_*）---
PROFIT_SHARING_ENABLED=true
PROFIT_SHARING_MOCK_ENABLED=true
PROFIT_SHARING_RETRY_ENABLED=true
PROFIT_SHARING_RETRY_BATCH_SIZE=20
WECHAT_PAY_ENABLED=false

# --- 对外 URL（生产改为真实域名，用于微信支付 notify）---
PUBLIC_BASE_URL=http://localhost
WECHAT_NOTIFY_URL=http://localhost/api/v2/payment/wechat/notify
ALIPAY_NOTIFY_URL=http://localhost/api/v2/payment/alipay/notify
CORS_ORIGIN=http://localhost

# --- 微信 API v3（生产必填，dev 可留空走 mock）---
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_AUTO_FETCH=true
WECHAT_MINIAPP_ID=
WECHAT_MINIAPP_SECRET=

# --- 支付宝（充值 ALIPAY 渠道；沙箱见 infra/.env.sandbox.example）---
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost/api/v2/payment/alipay/notify

# --- 高德 Web Key（设备地址解析 / 地理编码；留空则后台提示未配置）---
AMAP_WEB_KEY=

# --- SMS（生产必填）---
SMS_WEBHOOK_URL=
# SMS_PROVIDER=webhook | aliyun | auto（有阿里云密钥则走阿里云）
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=
# SMS_ALIYUN_REGION_ID=cn-hangzhou
# dev profile 默认 SMS_MOCK_CODE=123456（application-dev.yml）；staging/prod 禁止使用内置 mock 码
# SMS_MOCK_CODE=123456

# --- MinIO（compose 内网默认即可；容器互访仍是 http://minio:9000）---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=cabinet-videos
# Host-side public URL for browser/presigned links.
# Windows Hyper-V 常预留 8905–9104，9000/9001 无法 bind（netstat 也可能为空）。
# 本机请叠加 docker-compose.win-ports.yml，并使用下列端口：
MINIO_PUBLIC_ENDPOINT=http://localhost:19000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# Linux/mac 若 9000 空闲可改回：
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- MQTT（dev 匿名；生产改 ssl:// 并配置账号）---
MQTT_BROKER=tcp://emqx:1883
EMQX_ALLOW_ANONYMOUS=true
# Host 映射端口（Windows Hyper-V 常保留 1822–1921，勿改回 1883/8883/18083）
# 默认 11883；若本机仍冲突可改为 12883（check-ports.ps1 / 文档均支持两种）
EMQX_MQTT_PORT=11883
EMQX_MQTT_TLS_PORT=18883
EMQX_DASHBOARD_PORT=28083

# --- vision-service ---
# 默认：mock + 可选 DeepSeek，便于无模型 E2E
VISION_MOCK_ENABLED=true
RECOGNIZER_BACKEND=yolo_deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=2000
DEEPSEEK_AUTO_CHARGE=false
AICABINET_GRAVITY_FALLBACK_SETTLE=false
VISION_INSTALL_ML=false
VISION_FORCE_REAL=false
YOLO_RECOGNITION_MODE=delta
# single_frame | delta（开门前后帧差异，推荐 delta）
YOLO_MODEL_PATH=/app/models/yolov8n.pt
YOLO_MODEL_VERSION=yolov8n
YOLO_AUTO_DOWNLOAD=true
YOLO_CONF=0.5
YOLO_REVIEW_CONF=0.7
#
# Phase 1 冷启动（无自有标注）：Retail-OS 本地 YOLO，不依赖 DeepSeek
# 1) 确认 vision-service/models/retail-os-v2.0.0.pt（或 scripts/download-retail-os-model.ps1）
# 2) 宿主机：. .\scripts\load-vision-dev-env.ps1
# 3) Docker：叠加 docker-compose.vision-local.yml（INSTALL_ML + retail-os + FORCE_REAL）
# 文档：docs/VISION_SKU_MODEL.md「无自有数据：Retail-OS 冷启动」
# 映射：Flyway V61 YOLO_RETAIL → 演示 SKU（非生产准确率）
#
OSS_REGION=cn-shanghai
OBJECT_STORAGE_SCHEME=minio
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Windows 可能保留 2947–3046 端口段，因此默认不使用宿主机 3000。
GRAFANA_PORT=13000

# --- DevOps 工具链（docker-compose.devops.yml --profile devops）---
SONAR_PORT=19002
JENKINS_PORT=19081
JENKINS_AGENT_PORT=50000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar
# GitHub 仓库与 Runner 一次性注册 token（Settings → Actions → Runners）
DEVOPS_GITHUB_URL=https://github.com/your-org/ai-cabinet
GITHUB_REPO_URL=https://github.com/your-org/ai-cabinet
GITHUB_RUNNER_TOKEN=
GITHUB_RUNNER_NAME=ai-cabinet-local
SONAR_TOKEN=
# 运营后台 DevOps 中心外链（浏览器访问）
DEVOPS_GRAFANA_URL=http://localhost/devops/grafana
DEVOPS_PROMETHEUS_URL=http://localhost:9090
DEVOPS_JENKINS_URL=http://localhost:19081
DEVOPS_SONAR_URL=http://localhost:19002
DEVOPS_GRAFANA_ROOT_URL=http://localhost/devops/grafana/
DEVOPS_GRAFANA_EMBED_PATH=/devops/grafana/d/ai-cabinet-overview/ai-cabinet-overview?orgId=1&kiosk=tv&theme=light
