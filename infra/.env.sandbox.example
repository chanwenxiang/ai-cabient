# 真实环境模拟测试 — 复制为 .env.sandbox 后按需填写
#   copy .env.sandbox.example .env.sandbox
#
# 启动：
#   docker compose --env-file .env.sandbox -f docker-compose.full.yml up -d --build

SPRING_PROFILES_ACTIVE=dev
AICABINET_STAGING_MODE=false
POSTGRES_PASSWORD=aicabinet
POSTGRES_PORT=15433

JWT_SECRET=sandbox-jwt-secret-key-32bytes-minimum-len
INTERNAL_API_KEY=dev-internal-key-change-me
VISION_API_KEY=dev-vision-key-change-me
CORS_ORIGIN=http://localhost

# --- 识别/结算：真实 YOLO；重力兜底仅沙箱 E2E（视觉空+重力有信号时可结算）---
AICABINET_MOCK_ENABLED=false
AICABINET_GRAVITY_FALLBACK_SETTLE=true
VISION_MOCK_ENABLED=true
VISION_FORCE_REAL=true
VISION_INSTALL_ML=true
RECON_MOCK_ENABLED=false

RECOGNIZER_BACKEND=yolo_deepseek
YOLO_RECOGNITION_MODE=delta
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=2000
DEEPSEEK_AUTO_CHARGE=false
YOLO_AUTO_DOWNLOAD=true
YOLO_CONF=0.45
YOLO_REVIEW_CONF=0.70

# --- 柜机模拟：上传 testdata 内图片/视频，清空重力购物车 ---
AICABINET_SIM_VIDEO_FILE=/testdata/bottle.jpg
AICABINET_SIM_GRAVITY_JSON=[]
AICABINET_SIM_SHOPPING_MS=8000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=cabinet-videos

EMQX_MQTT_PORT=11883
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- 支付宝沙箱（开放平台 → 沙箱环境）---
ALIPAY_ENABLED=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付完成同步跳回 H5（沙箱勿用 localhost，用 127.0.0.1）
ALIPAY_RETURN_URL=http://127.0.0.1:3002/
# 公网 HTTPS 回调；本地无隧道时可留空，支付后由前端轮询 GET /payment/recharge/{orderId} 同步
ALIPAY_NOTIFY_URL=
