      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(device_mqtt_door_total{result=\"forwarded\"}[5m]))", "legendFormat": "门事件转发" },
        { "expr": "sum(rate(device_mqtt_door_total{result=\"deduped\"}[5m]))", "legendFormat": "去重丢弃" },
        { "expr": "sum(rate(device_mqtt_heartbeat_total{result=\"forwarded\"}[5m]))", "legendFormat": "心跳转发" }
      ],
      "title": "device-service MQTT",
      "type": "timeseries"
    }
,
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "门事件（OPEN/CLOSED）被 device-service 完整送达 trade-service 的比例 = 转发成功 /(成功+失败)。指标：device_mqtt_door_total{result=forwarded}（MqttEventListener.java:328）与 device_trade_forward_total{result=failure}（同文件 :332）。⚠️ 转发失败**不 ACK**、由 broker 重投 ⇒ 本率是「重投前」的瞬时完整度，不是最终丢失率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.9999 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "sum(rate(device_mqtt_door_total{result=\"forwarded\"}[5m])) / ((sum(rate(device_mqtt_door_total{result=\"forwarded\"}[5m])) + sum(rate(device_trade_forward_total{result=\"failure\"}[5m]))) > 0)", "legendFormat": "门事件送达完整率" }
      ],
      "title": "门事件送达完整率 (5m)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "争议会话占全部已终结会话的比例 = DISPUTED /(COMPLETED+DISPUTED)，指标 cabinet_session_transition_total{state=...}。⚠️ 本仓识别不确定（needReview / 低置信 / 白名单不符）统一走 escalateToDispute（SettlementRecognitionService.java:335）⇒ 本率同时是**识别质量**的代理指标。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.03 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "sum(rate(cabinet_session_transition_total{state=\"DISPUTED\"}[5m])) / (sum(rate(cabinet_session_transition_total[5m])) > 0)", "legendFormat": "争议率" }
      ],
      "title": "争议率 (5m)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "近 5 分钟 device-service 向 trade-service 转发门事件失败速率（device_trade_forward_total{result=failure}）。失败不会丢：不 ACK ⇒ broker 重投；但持续 >0.1/s 会触发告警 MqttTradeForwardFailures。",
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "expr": "sum(rate(device_trade_forward_total{result=\"failure\"}[5m]))", "legendFormat": "转发失败" }
      ],
      "title": "MQTT 转发失败 (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "结算耗时（cabinet_settlement_duration_seconds，Micrometer Timer）。P95 用 histogram_quantile；均值 = sum(rate(_sum))/sum(rate(_count))。",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(cabinet_settlement_duration_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "sum(rate(cabinet_settlement_duration_seconds_sum[5m])) / sum(rate(cabinet_settlement_duration_seconds_count[5m]))", "legendFormat": "均值" }
      ],
      "title": "结算时长 P95 / 均值",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "MQTT 转发失败与设备指令异常速率。指令指标 device_command_total{result=ack_timeout|ack_failure} （DeviceMqttMetrics.java:34-38）。ack_timeout 触发告警 MqttCommandAckTimeout。",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(device_trade_forward_total{result=\"failure\"}[5m]))", "legendFormat": "转发失败" },
        { "expr": "sum(rate(device_command_total{result=\"ack_timeout\"}[5m]))", "legendFormat": "指令 ACK 超时" },
        { "expr": "sum(rate(device_command_total{result=\"ack_failure\"}[5m]))", "legendFormat": "指令 ACK 失败" }
      ],
      "title": "MQTT 转发失败 / 指令 ACK 异常",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "真值口径：人工复核结论（KEEP=识别正确；WAIVE/ADJUST/CONFIRM=识别有误）。分母是**被提起争议**的会话（有偏样本），是「争议子集上的准确率」，用于趋势与下钻，不可读作全站准确率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 40 },
      "id": 13,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(rate(cabinet_recognition_human_verdict_total{verdict=\"correct\"}[6h])) / (sum(rate(cabinet_recognition_human_verdict_total[6h])) > 0)",
          "legendFormat": "人工复核判「识别正确」占比"
        }
      ],
      "title": "识别准确率（人工复核真值 · 争议子集）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "按 review_code 下钻：哪一类失败（MOCK/EMPTY/LOW_CONF/UNMAPPED/WHITELIST/GRAVITY_MISMATCH/NEED_REVIEW）被人工判为识别有误最多。",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 40 },
      "id": 14,
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "expr": "increase(cabinet_recognition_human_verdict_total{verdict=\"wrong\"}[24h])",
          "format": "table",
          "instant": true
        }
      ],
      "title": "判「识别有误」按 review_code 下钻 (24h)",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P0-1 阶段 B 边缘盒监控：在线设备中固件版本 != aicabinet.edge.expected-firmware 的台数。值为 -1 表示未配置期望版本（此时 EdgeFirmwareOutdated 告警不触发）。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 40 },
      "id": 15,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "cabinet_edge_firmware_outdated_count", "legendFormat": "固件≠期望版本(在线台数)" }
      ],
      "title": "边缘盒固件漂移（-1=未配置期望版本）",
      "type": "stat"
    }
  ],
