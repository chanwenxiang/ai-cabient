      "targets": [
        { "expr": "sum(rate(cabinet_session_transition_total{state=\"COMPLETED\"}[5m]))", "legendFormat": "完成" },
        { "expr": "sum(rate(cabinet_session_transition_total{state=\"DISPUTED\"}[5m]))", "legendFormat": "争议" }
