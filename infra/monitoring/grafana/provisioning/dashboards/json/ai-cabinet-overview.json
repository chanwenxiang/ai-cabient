    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "门事件（OPEN/CLOSED）被 device-service 完整送达 trade-service 的比例 = 转发成功 /(成功+失败)。指标：device_mqtt_door_total{result=forwarded}（MqttEventListener.java:328）与 device_trade_forward_total{result=failure}（同文件 :332）。⚠️ 转发失败**不 ACK**、由 broker 重投 ⇒ 本率是「重投前」的瞬时完整度，不是最终丢失率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.9999 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "sum(rate(device_mqtt_door_total{result=\"forwarded\"}[5m])) / ((sum(rate(device_mqtt_door_total{result=\"forwarded\"}[5m])) + sum(rate(device_trade_forward_total{result=\"failure\"}[5m]))) > 0)", "legendFormat": "门事件送达完整率" }
      ],
      "title": "门事件送达完整率 (5m)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
