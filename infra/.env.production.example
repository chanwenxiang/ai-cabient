# 生产环境模板 — 用于正式上线前配置检查
# 复制：copy .env.production.example .env.production  然后填写真实密钥与域名
# 检查：.\scripts\verify-production-readiness.ps1

SPRING_PROFILES_ACTIVE=prod
AICABINET_STAGING_MODE=false
POSTGRES_PASSWORD=CHANGE-ME-strong-postgres-password-32chars
POSTGRES_PORT=15433

JWT_SECRET=CHANGE-ME-production-jwt-secret-32bytes-min
INTERNAL_API_KEY=CHANGE-ME-production-internal-api-key-32b
VISION_API_KEY=CHANGE-ME-production-vision-api-key-32bytes
# 浏览器会话 Cookie（admin 控制台）：生产 HTTPS 必须开启 Secure；禁用可设 false
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=true

AICABINET_MOCK_ENABLED=false
VISION_MOCK_ENABLED=false
RECON_MOCK_ENABLED=false

PUBLIC_BASE_URL=https://ops.your-domain.com
WECHAT_NOTIFY_URL=https://ops.your-domain.com/api/v2/payment/wechat/notify
CORS_ORIGIN=https://ops.your-domain.com
SMS_WEBHOOK_URL=https://your-sms-gateway.example.com/send

WECHAT_APP_ID=wxYOUR_APP_ID
WECHAT_MCH_ID=YOUR_MCH_ID
WECHAT_API_V3_KEY=YOUR_32_BYTE_API_V3_KEY_HERE!!
WECHAT_MCH_SERIAL=YOUR_MCH_CERT_SERIAL
WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_AUTO_FETCH=true
WECHAT_MINIAPP_ID=wxYOUR_MINIAPP_ID
WECHAT_MINIAPP_SECRET=YOUR_MINIAPP_SECRET

PROFIT_SHARING_ENABLED=true
PROFIT_SHARING_MOCK_ENABLED=false
PROFIT_SHARING_RETRY_ENABLED=true
PROFIT_SHARING_RETRY_BATCH_SIZE=20
WECHAT_PAY_ENABLED=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-strong-password
MINIO_BUCKET=cabinet-videos
MINIO_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
MINIO_ACCESS_KEY=YOUR_OSS_ACCESS_KEY_ID
MINIO_SECRET_KEY=YOUR_OSS_ACCESS_KEY_SECRET
MINIO_PUBLIC_ENDPOINT=https://cdn.your-domain.com
OSS_REGION=cn-shanghai
OBJECT_STORAGE_SCHEME=oss

MQTT_BROKER=ssl://emqx:8883
EMQX_ALLOW_ANONYMOUS=false
EMQX_MQTT_PORT=11883
EMQX_MQTT_TLS_PORT=18883
EMQX_DASHBOARD_PORT=28083

RECOGNIZER_BACKEND=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=2000
DEEPSEEK_AUTO_CHARGE=false
AICABINET_GRAVITY_FALLBACK_SETTLE=false

# 生产识别由端侧提供方回传；vision-service 仅保留争议辅助与开发联调 mock
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=redpanda:9092

# 微信小程序合法域名（须与 PUBLIC_BASE_URL / OSS CDN 一致）
WECHAT_MINIAPP_DOWNLOAD_DOMAIN=https://cdn.your-domain.com
WECHAT_MINIAPP_REQUEST_DOMAIN=https://ops.your-domain.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-grafana-password
