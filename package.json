{
  "name": "ai-cabinet-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:admin": "pnpm --filter @aicabinet/admin-vue dev",
    "build:admin": "node scripts/build-admin.mjs",
    "build:admin:typecheck": "pnpm --filter @aicabinet/admin-vue type-check",
    "dev:consumer-mp": "pnpm --filter @aicabinet/consumer-mp dev:mp-weixin",
    "dev:consumer-h5": "pnpm --filter @aicabinet/consumer-mp dev:h5",
    "build:consumer-mp": "pnpm --filter @aicabinet/consumer-mp build:mp-weixin",
    "dev:merchant-mp": "pnpm --filter @aicabinet/merchant-mp dev:mp-weixin",
    "dev:merchant-h5": "pnpm --filter @aicabinet/merchant-mp dev:h5",
    "build:merchant-mp": "pnpm --filter @aicabinet/merchant-mp build:mp-weixin",
    "build:packages": "pnpm -r --filter @aicabinet/shared-types --filter @aicabinet/shared-dict --filter @aicabinet/shared-rbac --filter @aicabinet/shared-api build",
    "check:shared": "pnpm build:packages && pnpm --filter @aicabinet/shared-rbac test && pnpm check:nav-perms",
    "test:mp": "pnpm --filter @aicabinet/consumer-mp run test:ci && pnpm --filter @aicabinet/merchant-mp run test:ci",
    "check:nav-perms": "node scripts/check-nav-perms.mjs",
    "check:openapi-types": "node scripts/check-openapi-types.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "smoke:realms": "node scripts/smoke-realms.mjs",
    "smoke:admin-list-race": "node scripts/smoke-admin-list-race.mjs",
    "smoke:admin-a11y": "node scripts/smoke-admin-a11y.mjs",
    "gen:api-types": "node scripts/gen-openapi-types.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"clients/**/*.{ts,vue,js,mjs,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"clients/**/*.{ts,vue,js,mjs,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "check": "pnpm lint && pnpm format:check && pnpm check:shared",
    "audit:deps": "pnpm audit --registry https://registry.npmjs.org/",
    "audit:backend": "node scripts/audit-backend-deps.mjs"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3": "3.3.18",
      "jpeg-js": "0.4.4",
      "qs": "6.16.0",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "@intlify/core-base": "9.14.5",
      "@intlify/message-resolver": "9.1.11",
      "phin": "3.7.1"
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-vue": "^9",
    "globals": "^15",
    "openapi-typescript": "^7.4.4",
    "playwright": "1.55.0",
    "prettier": "^3",
    "typescript-eslint": "^8"
  }
}
