{
  "name": "ai-cabinet-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:admin": "pnpm --filter @aicabinet/admin-vue dev",
    "build:admin": "node scripts/build-admin.mjs",
    "build:admin:typecheck": "pnpm --filter @aicabinet/admin-vue type-check",
    "gate:admin-tables": "node scripts/check-admin-table-gate.mjs",
    "dev:consumer-mp": "pnpm --filter @aicabinet/consumer-mp dev:mp-weixin",
    "dev:consumer-h5": "pnpm --filter @aicabinet/consumer-mp dev:h5",
    "build:consumer-mp": "pnpm --filter @aicabinet/consumer-mp build:mp-weixin",
    "dev:merchant-mp": "pnpm --filter @aicabinet/merchant-mp dev:mp-weixin",
    "dev:merchant-h5": "pnpm --filter @aicabinet/merchant-mp dev:h5",
    "build:merchant-mp": "pnpm --filter @aicabinet/merchant-mp build:mp-weixin",
    "build:packages": "pnpm -r --filter @aicabinet/shared-types --filter @aicabinet/shared-dict --filter @aicabinet/shared-rbac --filter @aicabinet/shared-api build",
    "check:shared": "pnpm build:packages && pnpm --filter @aicabinet/shared-rbac test && pnpm check:nav-perms",
    "test:mp": "pnpm --filter @aicabinet/consumer-mp run test:ci && pnpm --filter @aicabinet/merchant-mp run test:ci",
    "check:nav-perms": "node scripts/check-nav-perms.mjs",
    "check:admin-table-align": "node scripts/check-admin-table-align.mjs",
    "check:admin-page-size": "node scripts/check-admin-page-size.mjs",
    "check:admin-dialog-a11y": "node scripts/check-admin-dialog-a11y.mjs",
    "check:scheduled-zone": "node scripts/check-scheduled-zone.mjs",
    "check:cache-names": "node scripts/check-cache-names.mjs",
    "check:admin-endpoints": "node scripts/check-admin-endpoints.mjs",
    "check:consumer-endpoints": "node scripts/check-consumer-endpoints.mjs",
    "check:merchant-endpoints": "node scripts/check-merchant-endpoints.mjs",
    "check:admin-token-storage": "node scripts/check-admin-token-storage.mjs",
    "check:audit-gates": "pnpm check:audit-gates-wiring && pnpm check:preflight-wiring && pnpm check:shared-component-sync && pnpm check:wxss-no-color-mix && pnpm check:line-endings && pnpm check:demo-video-format && pnpm check:uat-consumers && pnpm check:feature-flags && pnpm check:mp-unit-tests-wired && pnpm check:android-tests-wired && pnpm check:edge-cloud-mqtt-contract && pnpm check:ops-alert-escalation && pnpm check:docker-tests-guarded && pnpm check:compose-stop-grace && pnpm check:menu-permissions && pnpm check:compose-ports && pnpm check:mybatis-null-clear && pnpm check:ops-alert-channels && pnpm check:miniapp-privacy-declaration && pnpm check:prometheus-metric-names && pnpm check:replenishment-checkin-contract && pnpm check:edge-queue-threading && pnpm check:admin-dialog-a11y && pnpm check:scheduled-zone && pnpm check:cache-names && pnpm check:admin-endpoints && pnpm check:consumer-endpoints && pnpm check:merchant-endpoints && pnpm check:admin-token-storage && pnpm check:admin-page-size && pnpm check:admin-anti-jitter && pnpm check:admin-table-align && pnpm check:mp-a11y && pnpm check:balance-hold-types && pnpm check:uat-selectors && pnpm check:device-code-input && pnpm check:xxl-job-wiring && pnpm check:scheduled-task-seed && pnpm check:scheduling-vs-db-pool",
    "check:xxl-job-wiring": "node scripts/check-xxl-job-wiring.mjs",
    "check:scheduled-task-seed": "node scripts/check-scheduled-task-seed.mjs",
    "check:scheduling-vs-db-pool": "node scripts/check-scheduling-vs-db-pool.mjs",
    "check:audit-gates-wiring": "node scripts/check-audit-gates-wiring.mjs",
    "check:preflight-wiring": "node scripts/check-preflight-wiring.mjs",
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "check:demo-video-format": "node scripts/check-demo-video-format.mjs",
    "check:shared-component-sync": "node scripts/style-full-audit.mjs --check && node scripts/sync-shared-uni-components.mjs --check",
    "sync:shared-uni-components": "node scripts/sync-shared-uni-components.mjs",
    "check:wxss-no-color-mix": "node scripts/check-wxss-no-color-mix.mjs",
    "check:feature-flags": "node scripts/check-feature-flags.mjs",
    "check:docker-tests-guarded": "node scripts/check-docker-tests-guarded.mjs",
    "check:mp-unit-tests-wired": "node scripts/check-mp-unit-tests-wired.mjs",
    "check:android-tests-wired": "node scripts/check-android-tests-wired.mjs",
    "check:compose-stop-grace": "node scripts/check-compose-stop-grace.mjs",
    "check:menu-permissions": "node scripts/check-menu-permissions.mjs",
    "check:compose-ports": "node scripts/check-compose-ports.mjs",
    "check:mybatis-null-clear": "node scripts/check-mybatis-null-clear.mjs",
    "check:audit-gates:local": "node scripts/run-audit-gates.mjs",
    "check:admin-anti-jitter": "node scripts/check-admin-anti-jitter.mjs",
    "check:mp-a11y": "node scripts/check-mp-a11y-coverage.mjs",
    "check:balance-hold-types": "node scripts/check-balance-hold-types.mjs",
    "check:uat-consumers": "node scripts/check-uat-consumers.mjs",
    "check:uat-selectors": "node scripts/check-uat-selectors.mjs",
    "check:device-code-input": "node scripts/check-device-code-input.mjs",
    "migrate:hex-tokens": "node scripts/migrate-hex-tokens.mjs",
    "check:openapi-types": "node scripts/check-openapi-types.mjs",
    "check:replenishment-checkin-contract": "node scripts/check-replenishment-checkin-contract.mjs",
    "check:ops-alert-channels": "node scripts/check-ops-alert-channels.mjs",
    "check:ops-alert-escalation": "node scripts/check-ops-alert-escalation.mjs",
    "check:miniapp-privacy-declaration": "node scripts/check-miniapp-privacy-declaration.mjs",
    "check:prometheus-metric-names": "node scripts/check-prometheus-metric-names.mjs",
    "check:edge-queue-threading": "node scripts/check-edge-queue-threading.mjs",
    "check:edge-cloud-mqtt-contract": "node scripts/check-edge-cloud-mqtt-contract.mjs",
    "check:flyway-seed-separation": "node scripts/check-flyway-seed-separation.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "smoke:realms": "node scripts/smoke-realms.mjs",
    "smoke:admin-list-race": "node scripts/smoke-admin-list-race.mjs",
    "smoke:admin-a11y": "node scripts/smoke-admin-a11y.mjs",
    "check:admin-bundle": "node scripts/check-admin-bundle-budget.mjs",
    "gen:api-types": "node scripts/gen-openapi-types.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"clients/**/*.{ts,vue,js,mjs,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"clients/**/*.{ts,vue,js,mjs,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "check": "pnpm lint && pnpm format:check && pnpm check:shared",
    "preflight": "node scripts/pre-push-ci-preflight.mjs",
    "preflight:quick": "node scripts/pre-push-ci-preflight.mjs --quick",
    "preflight:full": "node scripts/pre-push-ci-preflight.mjs --full",
    "audit:deps": "pnpm audit --registry https://registry.npmjs.org/",
    "audit:frontend": "node scripts/audit-frontend-deps.mjs",
    "audit:backend": "node scripts/audit-backend-deps.mjs",
    "check:merchant-nav-guard": "node scripts/check-merchant-nav-guard.mjs"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3": "3.3.18",
      "jpeg-js": "0.4.4",
      "qs": "6.16.0",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "@intlify/core-base": "9.14.5",
      "@intlify/message-resolver": "9.1.11",
      "phin": "3.7.1"
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-vue": "^9",
    "globals": "^15",
    "openapi-typescript": "^7.4.4",
    "playwright": "1.55.0",
    "prettier": "^3",
    "typescript-eslint": "^8"
  }
}
