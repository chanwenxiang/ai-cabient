<view class="container">
  <view class="page-head">
    <text class="page-title">{{openCount ? openCount + ' 笔审核中' : '申诉进度'}}</text>
    <button class="refresh-btn" size="mini" bindtap="onRefresh" loading="{{refreshing}}">刷新</button>
  </view>

  <view class="summary card" wx:if="{{openCount > 0}}">
    <text class="summary-title">{{openCount}} 笔申诉审核中</text>
    <text class="summary-desc">运营确认商品后会自动扣款，请耐心等待</text>
  </view>

  <view class="hint card" wx:if="{{!loading && !tickets.length}}">
    <text class="empty-title">暂无申诉记录</text>
    <text class="empty-desc">识别不确定或未识别到商品时，系统会自动创建申诉工单；您也可在「购物订单」中手动提交申诉。</text>
    <button size="mini" class="link-btn" bindtap="goOrders">查看购物订单</button>
  </view>

  <view class="ticket card {{item.overdue ? 'overdue' : ''}}" wx:for="{{tickets}}" wx:key="ticketId">
    <view class="ticket-head" bindtap="toggleTicket" data-id="{{item.ticketId}}">
      <view class="head-left">
        <text class="status {{item.statusClass}}">{{item.statusLabel}}</text>
        <text class="overdue-tag" wx:if="{{item.overdue}}">等待较久</text>
      </view>
      <text class="chevron">{{item.expanded ? '▾' : '▸'}}</text>
    </view>

    <view class="row">
      <text class="label">设备</text>
      <text>{{item.deviceId || '-'}}</text>
    </view>
    <view class="row" wx:if="{{item.status === 'OPEN' && item.waitText}}">
      <text class="label">已等待</text>
      <text class="wait">{{item.waitText}}</text>
    </view>
    <view class="row" wx:if="{{item.hasResolution}}">
      <text class="label">结案商品</text>
      <text class="emph">{{item.resolutionSummary}}</text>
    </view>
    <view class="row" wx:elif="{{item.hasSuggested && !item.expanded}}">
      <text class="label">识别建议</text>
      <text>{{item.suggestedSummary}}</text>
    </view>

    <view class="detail" wx:if="{{item.expanded}}">
      <view class="row">
        <text class="label">工单号</text>
        <text class="mono">{{item.ticketId}}</text>
      </view>
      <view class="row">
        <text class="label">会话</text>
        <text class="mono">{{item.sessionId}}</text>
      </view>
      <view class="row" wx:if="{{item.reason}}">
        <text class="label">原因</text>
        <text>{{item.reason}}</text>
      </view>
      <view class="row">
        <text class="label">提交时间</text>
        <text>{{item.createdAtText}}</text>
      </view>
      <view class="row" wx:if="{{item.resolvedAtText && item.resolvedAtText !== '-'}}">
        <text class="label">处理时间</text>
        <text>{{item.resolvedAtText}}</text>
      </view>
      <view class="items" wx:if="{{item.hasSuggested}}">
        <text class="label block">识别建议</text>
        <view class="item" wx:for="{{item.suggestedItems}}" wx:for-item="line" wx:key="skuId">
          <text>{{line.displayText}}</text>
        </view>
      </view>
      <view class="items resolved" wx:if="{{item.hasResolution}}">
        <text class="label block">最终扣款商品</text>
        <view class="item" wx:for="{{item.resolutionItems}}" wx:for-item="line" wx:key="skuId">
          <text>{{line.displayText}}</text>
        </view>
      </view>
    </view>

    <view class="foot" bindtap="toggleTicket" data-id="{{item.ticketId}}">
      <text>{{item.expanded ? '收起详情' : '查看详情'}}</text>
    </view>
  </view>
</view>
