<view class="container">
  <view class="hint card" wx:if="{{!loading && !tickets.length}}">
    <text class="empty-title">暂无申诉记录</text>
    <text class="empty-desc">若购物识别有误，系统会自动创建申诉工单，运营审核后会通知扣款结果。</text>
  </view>

  <view class="ticket card" wx:for="{{tickets}}" wx:key="ticketId">
    <view class="row">
      <text class="label">工单号</text>
      <text class="mono">{{item.ticketId}}</text>
    </view>
    <view class="row">
      <text class="label">会话</text>
      <text class="mono">{{item.sessionId}}</text>
    </view>
    <view class="row">
      <text class="label">状态</text>
      <text class="status {{item.statusClass}}">{{item.statusLabel}}</text>
    </view>
    <view class="row" wx:if="{{item.reason}}">
      <text class="label">原因</text>
      <text>{{item.reason}}</text>
    </view>
    <view class="row">
      <text class="label">提交时间</text>
      <text>{{item.createdAtText}}</text>
    </view>
    <view class="items" wx:if="{{item.suggestedItems.length}}">
      <text class="label">识别建议</text>
      <view class="item" wx:for="{{item.suggestedItems}}" wx:for-item="line" wx:key="skuId">
        <text>{{line.skuName || line.skuId}} × {{line.quantity}}</text>
      </view>
    </view>
  </view>
</view>
