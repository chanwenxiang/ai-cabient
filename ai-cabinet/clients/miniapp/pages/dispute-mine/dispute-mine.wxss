.container { padding: 24rpx; padding-bottom: 120rpx; }

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.refresh-btn { margin: 0 !important; }

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.summary {
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #fff7e6, #fff);
  border: 1px solid #ffe7ba;
}

.summary-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #d46b08;
  margin-bottom: 8rpx;
}

.summary-desc {
  display: block;
  font-size: 24rpx;
  color: #8c8c8c;
}

.hint {
  text-align: center;
  padding: 48rpx 32rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  color: #666;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.link-btn { margin-top: 8rpx; }

.ticket {
  padding: 24rpx 28rpx;
}

.ticket.overdue {
  border: 1px solid #ffccc7;
}

.ticket-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chevron {
  color: #999;
  font-size: 28rpx;
}

.overdue-tag {
  font-size: 22rpx;
  color: #cf1322;
  background: #fff1f0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
  flex-shrink: 0;
}

.label.block {
  display: block;
  margin-bottom: 8rpx;
}

.mono {
  font-family: monospace;
  word-break: break-all;
  text-align: right;
}

.status {
  font-weight: 600;
  font-size: 30rpx;
}

.status.open { color: #fa8c16; }
.status.resolved { color: #52c41a; }

.wait { color: #fa8c16; font-weight: 500; }
.emph { color: #1677ff; font-weight: 500; text-align: right; }

.detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.items {
  margin-top: 16rpx;
  padding-top: 12rpx;
}

.items.resolved {
  background: #f6ffed;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.item {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
}

.foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1677ff;
  padding-top: 12rpx;
  border-top: 1px dashed #f0f0f0;
}
