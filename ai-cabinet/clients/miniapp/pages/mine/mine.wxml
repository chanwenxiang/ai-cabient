<view class="container">
  <view class="profile card">
    <view class="phone">{{phoneMasked}}</view>
    <view class="balance">¥{{balanceYuan}}</view>
    <view class="tags">
      <text class="tag" wx:if="{{account.verified}}">已实名</text>
      <text class="tag warn" wx:else>未实名</text>
      <text class="tag ops" wx:if="{{account.operator}}">运营账号</text>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goRecharge">
      <text>余额充值</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrders">
      <text>购物订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goRecharges">
      <text>充值记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goDisputeMine">
      <text>申诉进度</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="menu card" wx:if="{{account.operator}}">
    <view class="section-title">运营工具</view>
    <view class="menu-item" bindtap="goOps">
      <text>补货开门</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goDisputes">
      <text>争议审核</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <button class="logout" bindtap="onLogout">退出登录</button>
</view>
