.container { padding: 24rpx; padding-bottom: 120rpx; min-height: 100vh; background: #f5f6f8; }
.card { background: #fff; border-radius: 16rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.profile { padding: 40rpx 32rpx; text-align: center; }
.phone { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.balance { font-size: 56rpx; font-weight: 700; color: #1677ff; margin-bottom: 20rpx; }
.tags { display: flex; justify-content: center; gap: 12rpx; flex-wrap: wrap; }
.tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: #e6f4ff; color: #1677ff; }
.tag.warn { background: #fff7e6; color: #fa8c16; }
.tag-warn { font-size: 22rpx; color: #fa8c16; margin-right: 8rpx; }
.tag.ops { background: #f6ffed; color: #52c41a; }
.menu { padding: 8rpx 0; }
.section-title { padding: 20rpx 32rpx 8rpx; font-size: 24rpx; color: #999; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1px solid #f0f0f0; font-size: 30rpx; }
.menu-left { flex: 1; }
.menu-sub { display: block; font-size: 22rpx; color: #999; margin-top: 6rpx; }
.badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  margin-right: 8rpx;
}
.loading-wrap { padding: 80rpx; text-align: center; color: #999; font-size: 28rpx; }
.menu-item .menu-sub { font-size: 24rpx; color: #999; margin-left: auto; margin-right: 12rpx; }
.arrow { color: #ccc; font-size: 36rpx; line-height: 1; }
.logout { margin-top: 40rpx; background: #fff; color: #ff4d4f; border: none; }
