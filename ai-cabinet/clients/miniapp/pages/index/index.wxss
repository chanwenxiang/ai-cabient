.container { padding: 40rpx; padding-bottom: 120rpx; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: bold; }
.balance { font-size: 28rpx; color: #1677ff; font-weight: 600; }
.input { border: 1px solid #ddd; padding: 20rpx; margin-bottom: 16rpx; border-radius: 8rpx; }
.device-hint { font-size: 24rpx; margin-bottom: 24rpx; padding: 12rpx 16rpx; border-radius: 8rpx; background: #f5f5f5; color: #666; }
.device-hint.ok { background: #f6ffed; color: #389e0d; }
.device-hint.warn { background: #fff7e6; color: #d46b08; }
button { margin-bottom: 20rpx; }
.status { margin-top: 32rpx; padding: 24rpx; background: #f7f8fa; border-radius: 12rpx; display: flex; flex-direction: column; gap: 12rpx; border-left: 6rpx solid #1677ff; }
.status-title { font-size: 26rpx; color: #999; }
.mono { font-size: 24rpx; color: #666; word-break: break-all; }
.state { font-size: 32rpx; color: #1677ff; font-weight: 600; }
.hint { font-size: 24rpx; color: #666; line-height: 1.5; }
.tone-active { border-left-color: #1677ff; background: #f0f7ff; }
.tone-active .state { color: #1677ff; }
.tone-wait { border-left-color: #faad14; background: #fffbe6; }
.tone-wait .state { color: #d48806; }
.tone-success { border-left-color: #52c41a; background: #f6ffed; }
.tone-success .state { color: #389e0d; }
.tone-error { border-left-color: #ff4d4f; background: #fff2f0; }
.tone-error .state { color: #cf1322; }
.tone-idle { border-left-color: #d9d9d9; }
.progress { height: 6rpx; background: #e6f4ff; border-radius: 999rpx; overflow: hidden; margin-top: 8rpx; }
.progress-bar { height: 100%; width: 40%; background: #1677ff; border-radius: 999rpx; animation: progress-slide 1.2s ease-in-out infinite; }
@keyframes progress-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}
