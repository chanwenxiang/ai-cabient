.page { min-height: 100vh; background: #f5f7fa; padding: 24rpx 24rpx 40rpx; box-sizing: border-box; }

.top-bar { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; gap: 16rpx; }
.brand-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.brand-sub { display: block; font-size: 22rpx; color: #8c8c8c; margin-top: 6rpx; }
.balance-chip {
  background: #fff; border-radius: 16rpx; padding: 12rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.08); text-align: right; min-width: 160rpx;
}
.balance-chip.low { background: #fff2f0; }
.balance-label { display: block; font-size: 20rpx; color: #999; }
.balance-value { display: block; font-size: 30rpx; font-weight: 700; color: #1677ff; }
.balance-chip.low .balance-value { color: #cf1322; }
.balance-refresh { font-size: 22rpx; color: #bbb; margin-left: 6rpx; }

.device-panel { background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.device-input-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx; }
.device-input { flex: 1; border: 1px solid #e8e8e8; padding: 18rpx 20rpx; border-radius: 12rpx; font-size: 28rpx; background: #fafafa; }
.scan-btn { flex-shrink: 0; background: #f0f7ff !important; color: #1677ff !important; border: 1px solid #91caff !important; }

.device-card { display: flex; align-items: flex-start; gap: 16rpx; padding: 16rpx; border-radius: 12rpx; background: #fafafa; border: 1px solid #f0f0f0; }
.device-card.ok { background: #f6ffed; border-color: #b7eb8f; }
.device-card.warn { background: #fff7e6; border-color: #ffd591; }
.device-card.busy { background: #fff1f0; border-color: #ffccc7; }
.device-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; background: #bfbfbf; flex-shrink: 0; }
.device-card.ok .device-dot { background: #52c41a; }
.device-card.warn .device-dot { background: #fa8c16; }
.device-card.busy .device-dot { background: #ff4d4f; }
.device-info { flex: 1; }
.device-title { display: block; font-size: 28rpx; font-weight: 600; color: #333; }
.device-desc { display: block; font-size: 24rpx; color: #666; margin-top: 4rpx; }
.scan-hint { font-size: 22rpx; color: #1677ff; margin-top: 8rpx; }

.section-head { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #1a1a2e; }
.section-meta { font-size: 22rpx; color: #999; }
.section-meta.loading { color: #1677ff; }

.category-block { margin-bottom: 28rpx; }
.category-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; padding: 0 4rpx; }
.category-icon { font-size: 32rpx; }
.category-name { font-size: 28rpx; font-weight: 700; color: #333; flex: 1; }
.category-count { font-size: 22rpx; color: #999; }

.product-empty { background: #fff; border-radius: 20rpx; padding: 60rpx 40rpx; text-align: center; margin-bottom: 24rpx; }
.empty-icon { display: block; font-size: 64rpx; margin-bottom: 16rpx; }
.empty-title { display: block; font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.empty-desc { display: block; font-size: 24rpx; color: #999; line-height: 1.5; }

.product-grid { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.product-card { display: flex; background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.product-img { width: 180rpx; height: 180rpx; flex-shrink: 0; background: linear-gradient(135deg, #e6f4ff, #f0f5ff); }
.product-img-ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.ph-icon { font-size: 44rpx; }
.ph-initial { font-size: 28rpx; font-weight: 700; color: #666; }
.product-body { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.product-name { font-size: 30rpx; font-weight: 600; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-meta { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.product-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.product-price { font-size: 34rpx; font-weight: 700; color: #ff4d4f; }

.qty-ctrl { display: flex; align-items: center; gap: 8rpx; background: #f5f5f5; border-radius: 999rpx; padding: 4rpx; }
.qty-ctrl.small { transform: scale(0.9); }
.qty-btn { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; background: #fff; border-radius: 50%; font-size: 32rpx; color: #1677ff; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.qty-num { min-width: 40rpx; text-align: center; font-size: 28rpx; font-weight: 600; }
.add-btn { background: #1677ff; color: #fff; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 999rpx; font-weight: 600; }

.cart-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #1a1a2e; border-radius: 999rpx; display: flex; align-items: center;
  padding: 12rpx 12rpx 12rpx 24rpx; z-index: 100; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
}
.cart-left { flex: 1; display: flex; align-items: center; gap: 16rpx; }
.cart-badge { background: #ff4d4f; color: #fff; min-width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; font-size: 24rpx; font-weight: 700; }
.cart-total { display: block; color: #fff; font-size: 32rpx; font-weight: 700; }
.cart-hint { display: block; color: rgba(255,255,255,0.55); font-size: 20rpx; }
.checkout-btn { background: #1677ff !important; color: #fff !important; border-radius: 999rpx !important; font-size: 28rpx !important; font-weight: 600 !important; padding: 0 36rpx !important; margin: 0 !important; }
.cart-placeholder { height: 120rpx; }

.open-panel { background: #fff; border-radius: 20rpx; padding: 32rpx; text-align: center; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.open-main-btn { width: 100% !important; border-radius: 16rpx !important; font-size: 32rpx !important; font-weight: 600 !important; }
.open-tip { display: block; font-size: 22rpx; color: #999; margin-top: 16rpx; }

.status { margin-top: 16rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; display: flex; flex-direction: column; gap: 12rpx; border-left: 6rpx solid #1677ff; }
.status-title { font-size: 26rpx; color: #999; }
.mono { font-size: 24rpx; color: #666; word-break: break-all; }
.state { font-size: 32rpx; color: #1677ff; font-weight: 600; }
.hint { font-size: 24rpx; color: #666; line-height: 1.5; }
.tone-active { border-left-color: #1677ff; background: #f0f7ff; }
.tone-wait { border-left-color: #faad14; background: #fffbe6; }
.tone-success { border-left-color: #52c41a; background: #f6ffed; }
.tone-error { border-left-color: #ff4d4f; background: #fff2f0; }
.tone-idle { border-left-color: #d9d9d9; }
.progress { height: 6rpx; background: #e6f4ff; border-radius: 999rpx; overflow: hidden; }
.progress-bar { height: 100%; width: 40%; background: #1677ff; border-radius: 999rpx; animation: progress-slide 1.2s ease-in-out infinite; }
.poll-error { margin-top: 8rpx; padding: 16rpx; background: #fff1f0; border-radius: 8rpx; display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; color: #cf1322; }
.abandon-btn { margin-top: 8rpx; }
@keyframes progress-slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(350%); } }

.sheet-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 200; }
.cart-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; background: #fff;
  border-radius: 24rpx 24rpx 0 0; z-index: 201; transform: translateY(100%);
  transition: transform 0.25s ease; max-height: 70vh; display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.cart-sheet.open { transform: translateY(0); }
.sheet-head { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 16rpx; border-bottom: 1px solid #f0f0f0; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-clear { font-size: 26rpx; color: #ff4d4f; }
.sheet-list { flex: 1; max-height: 50vh; padding: 16rpx 32rpx; }
.sheet-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #f5f5f5; }
.sheet-item-name { display: block; font-size: 28rpx; font-weight: 600; color: #333; }
.sheet-item-price { display: block; font-size: 24rpx; color: #999; margin-top: 4rpx; }
.sheet-foot { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 32rpx 32rpx; border-top: 1px solid #f0f0f0; font-size: 32rpx; font-weight: 700; }
