.container { padding: 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.hero { background: linear-gradient(135deg, #1677ff, #0958d9); border-radius: 24rpx; padding: 36rpx 32rpx; color: #fff; margin-bottom: 24rpx; }
.title { display: block; font-size: 32rpx; opacity: 0.9; margin-bottom: 8rpx; }
.amount { font-size: 64rpx; font-weight: 800; margin-bottom: 16rpx; }
.meta { display: block; font-size: 24rpx; opacity: 0.75; margin-top: 12rpx; }
.pay-meta { display: flex; gap: 12rpx; flex-wrap: wrap; }
.pay-tag { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; background: rgba(255,255,255,0.2); color: #fff; }
.pay-tag.method { background: rgba(255,255,255,0.28); }
.compare-card, .bill-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.compare-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.compare-title, .bill-title { font-size: 30rpx; font-weight: 700; color: #333; }
.compare-badge { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 999rpx; }
.tone-match { background: #f6ffed; color: #389e0d; }
.tone-more { background: #fff7e6; color: #d48806; }
.tone-less { background: #e6f4ff; color: #1677ff; }
.compare-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.compare-col { flex: 1; text-align: center; }
.compare-label { display: block; font-size: 22rpx; color: #999; margin-bottom: 6rpx; }
.compare-value { display: block; font-size: 36rpx; font-weight: 700; color: #666; }
.compare-value.actual { color: #1677ff; }
.compare-arrow { font-size: 28rpx; color: #bbb; padding: 0 12rpx; }
.compare-sub { display: block; font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.compare-line { display: flex; justify-content: space-between; font-size: 26rpx; color: #333; padding: 10rpx 0; border-bottom: 1px solid #f5f5f5; }
.compare-tip { display: block; font-size: 22rpx; color: #999; line-height: 1.5; margin-top: 16rpx; }
.line { display: flex; justify-content: space-between; align-items: flex-start; font-size: 28rpx; padding: 16rpx 0; border-bottom: 1px solid #f5f5f5; }
.line-main { display: flex; flex-direction: column; gap: 4rpx; flex: 1; padding-right: 16rpx; }
.batch { font-size: 22rpx; color: #999; }
.loading, .empty { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }
.empty-hint { text-align: center; color: #666; font-size: 28rpx; line-height: 1.6; padding: 24rpx 0 8rpx; }
