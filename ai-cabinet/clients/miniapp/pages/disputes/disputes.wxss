.container { padding: 32rpx; min-height: 100vh; background: #f5f6f8; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.hint { font-size: 24rpx; color: #999; margin-bottom: 24rpx; }
.loading, .empty { text-align: center; color: #999; padding: 80rpx 0; display: flex; flex-direction: column; gap: 12rpx; }
.empty-hint { font-size: 24rpx; color: #bbb; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; gap: 16rpx; padding: 8rpx 0; font-size: 28rpx; }
.label { color: #999; flex-shrink: 0; }
.mono { font-size: 24rpx; color: #666; word-break: break-all; text-align: right; }
.resolve-btn { margin-top: 16rpx; }
