<view class="container">
  <view class="title">争议审核</view>
  <view class="hint">运营账号专用，审核通过后用户将自动扣款</view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{tickets.length === 0}}" class="empty">
    <text>暂无待审核工单</text>
    <text class="empty-hint">识别存疑的购物会话会出现在这里</text>
  </view>

  <view class="card" wx:for="{{tickets}}" wx:key="ticketId">
    <view class="row"><text class="label">工单</text><text class="mono">{{item.ticketId}}</text></view>
    <view class="row"><text class="label">会话</text><text class="mono">{{item.sessionId}}</text></view>
    <view class="row"><text class="label">原因</text><text>{{item.reason || '-'}}</text></view>
    <view class="row" wx:if="{{item.createdAtText}}"><text class="label">时间</text><text>{{item.createdAtText}}</text></view>
    <button class="resolve-btn" size="mini" type="primary" data-id="{{item.ticketId}}" data-session="{{item.sessionId}}" bindtap="onResolve">审核通过（1 件可乐）</button>
  </view>
</view>
