.container { padding: 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.title { font-size: 36rpx; margin-bottom: 16rpx; font-weight: 700; }
.hint { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.demo-banner { background: #fff7e6; color: #ad6800; font-size: 24rpx; padding: 16rpx 20rpx; border-radius: 8rpx; margin-bottom: 24rpx; border: 1px solid #ffd591; }
.input { border: 1px solid #ddd; padding: 20rpx; margin-bottom: 30rpx; border-radius: 8rpx; background: #fff; }
.section { margin-top: 40rpx; }
.section-head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; color: #333; font-weight: 600; }
.refresh-link { font-size: 24rpx; color: #1677ff; }
.loading-tasks, .empty-tasks { font-size: 26rpx; color: #999; padding: 24rpx 0; text-align: center; }
.task-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12rpx; }
.task-device { display: block; font-size: 30rpx; font-weight: 600; color: #333; }
.task-id { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.status-PENDING { background: #fff7e6; color: #d48806; }
.status-IN_PROGRESS { background: #e6f4ff; color: #1677ff; }
.task-notes { font-size: 22rpx; color: #999; margin-bottom: 12rpx; }
.checkin-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.checkin-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.checkin-tag.ok { background: #f6ffed; color: #389e0d; }
.checkin-tag.pending { background: #fff7e6; color: #d48806; }
.task-actions { display: flex; gap: 12rpx; flex-wrap: wrap; }
.restock-status { margin-top: 24rpx; padding: 20rpx; background: #f0f7ff; border-radius: 8rpx; font-size: 26rpx; color: #333; line-height: 1.6; display: flex; flex-direction: column; gap: 8rpx; }
.recognition-section { margin-bottom: 32rpx; padding: 24rpx; background: #f6ffed; border: 1px solid #b7eb8f; border-radius: 12rpx; }
.section-desc { font-size: 24rpx; color: #666; line-height: 1.5; margin-bottom: 16rpx; }
.recognition-hint { font-size: 24rpx; color: #389e0d; line-height: 1.5; margin-top: 12rpx; }
.transit-card { background: #fff7e6; border: 1px solid #ffd591; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; }
.transit-device { display: block; font-size: 26rpx; font-weight: 600; color: #ad6800; }
.transit-line { display: block; font-size: 24rpx; color: #333; margin-top: 6rpx; }
.transit-meta { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
