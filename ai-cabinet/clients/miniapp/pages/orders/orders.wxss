.container { padding: 24rpx; min-height: 100vh; background: #f5f6f8; }
.empty { padding: 120rpx 0; text-align: center; color: #999; display: flex; flex-direction: column; gap: 24rpx; align-items: center; }
.empty-hint { font-size: 24rpx; color: #bbb; max-width: 480rpx; line-height: 1.5; }
.order-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; align-items: center; }
.top { margin-bottom: 16rpx; }
.sub { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.device { font-size: 32rpx; font-weight: 600; color: #222; }
.amount { font-size: 34rpx; color: #1677ff; font-weight: 600; }
.status { color: #52c41a; }
.mono { font-size: 22rpx; color: #aaa; max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.footer { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0 40rpx; }
