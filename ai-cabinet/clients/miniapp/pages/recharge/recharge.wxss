.container { padding: 40rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.balance { font-size: 32rpx; color: #1677ff; margin-bottom: 32rpx; font-weight: 600; }
.section-label { font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.channel-row { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.channel {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}
.channel.active { background: #e6f4ff; color: #1677ff; font-weight: 600; border: 1px solid #91caff; }
.quick-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.quick {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}
.quick.active { background: #e6f4ff; color: #1677ff; font-weight: 600; }
.input { border: 1px solid #ddd; padding: 20rpx; margin-bottom: 24rpx; border-radius: 8rpx; }
.hint { margin-top: 24rpx; color: #999; font-size: 24rpx; text-align: center; }
