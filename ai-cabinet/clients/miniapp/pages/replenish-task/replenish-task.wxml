<view class="page" wx:if="{{loading}}">
  <view class="loading">加载任务中…</view>
</view>

<view class="page" wx:else>
  <view class="task-head">
    <text class="task-title">任务 #{{taskId}}</text>
    <text class="task-meta">设备 {{deviceId}} · {{statusLabel}}</text>
    <text class="task-tip">录入上架/下架批次与效期，保存后点击「完成任务」写入库存</text>
    <button class="checkin-btn" size="mini" type="default" bindtap="onCheckIn" loading="{{checkingIn}}" wx:if="{{!checkedIn}}">到店签到 (GPS)</button>
    <text class="checkin-ok" wx:if="{{checkedIn}}">✓ 已签到 {{checkInTime}}</text>
  </view>

  <view class="line-card" wx:for="{{lines}}" wx:key="index" wx:for-index="idx">
    <view class="line-head">
      <picker mode="selector" range="{{lineTypes}}" range-key="label" value="{{item.typeIndex}}" data-idx="{{idx}}" bindchange="onLineTypeChange">
        <view class="picker-chip">{{lineTypes[item.typeIndex].label}}</view>
      </picker>
      <text class="line-del" data-idx="{{idx}}" bindtap="onRemoveLine" wx:if="{{lines.length > 1}}">删除</text>
    </view>
    <view class="field">
      <text class="label">商品</text>
      <picker mode="selector" range="{{skus}}" range-key="label" value="{{item.skuIndex}}" data-idx="{{idx}}" bindchange="onSkuChange">
        <view class="picker-value">{{skus[item.skuIndex].label || '选择商品'}}</view>
      </picker>
    </view>
    <view class="field-row">
      <view class="field half">
        <text class="label">数量</text>
        <input type="number" value="{{item.quantity}}" data-idx="{{idx}}" data-field="quantity" bindinput="onLineInput" />
      </view>
      <view class="field half">
        <text class="label">货道</text>
        <picker wx:if="{{item.slotOptions.length}}" mode="selector" range="{{item.slotOptions}}" range-key="label" value="{{item.slotIndex}}" data-idx="{{idx}}" bindchange="onSlotChange">
          <view class="picker-value">{{item.slotLabel}}</view>
        </picker>
        <input wx:else value="{{item.slotId}}" placeholder="A1" data-idx="{{idx}}" data-field="slotId" bindinput="onLineInput" />
      </view>
    </view>
    <view class="field">
      <text class="label">批次号</text>
      <input value="{{item.batchNo}}" placeholder="B20260701-001" data-idx="{{idx}}" data-field="batchNo" bindinput="onLineInput" />
    </view>
    <view class="field-row" wx:if="{{item.lineType === 'RESTOCK'}}">
      <view class="field half">
        <text class="label">生产日期</text>
        <picker mode="date" value="{{item.productionDate}}" data-idx="{{idx}}" bindchange="onProdDateChange">
          <view class="picker-value">{{item.productionDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="label">到期日</text>
        <picker mode="date" value="{{item.expiryDate}}" data-idx="{{idx}}" bindchange="onExpiryDateChange">
          <view class="picker-value">{{item.expiryDate || '选择日期'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <button class="add-line-btn" bindtap="onAddLine">+ 添加一行</button>

  <view class="foot-actions">
    <button type="primary" bindtap="onSaveLines" loading="{{saving}}">保存明细</button>
    <button type="warn" bindtap="onCompleteTask" loading="{{completing}}" disabled="{{completing}}">完成任务</button>
  </view>
</view>
