<view class="container">
  <view class="loading" wx:if="{{pageLoading}}">加载中…</view>

  <block wx:elif="{{verified}}">
    <view class="success-card card">
      <view class="success-icon">✓</view>
      <text class="success-title">已完成实名认证</text>
      <text class="success-desc">现在可以正常扫码开门购物了</text>
      <button type="primary" bindtap="goHome">去开门购物</button>
      <button class="ghost" bindtap="goMine">返回我的</button>
    </view>
  </block>

  <block wx:else>
    <view class="hero card">
      <text class="title">实名认证</text>
      <text class="hint">为保障账户与交易安全，首次开门购物前需完成实名认证。</text>
    </view>

    <view class="steps card">
      <view class="step"><text class="num">1</text><text>填写真实姓名</text></view>
      <view class="step"><text class="num">2</text><text>填写身份证后 4 位</text></view>
      <view class="step"><text class="num">3</text><text>提交后即可开门购物</text></view>
    </view>

    <view class="form card">
      <view class="field">
        <text class="label">真实姓名</text>
        <input class="input" placeholder="与身份证一致" value="{{realName}}" bindinput="onNameInput" />
      </view>
      <view class="field">
        <text class="label">身份证后 4 位</text>
        <input class="input" type="number" maxlength="4" placeholder="例如 1234" value="{{idCardLast4}}" bindinput="onIdInput" />
      </view>
      <text class="privacy">信息仅用于身份核验，不会对外展示完整证件号。</text>
      <button type="primary" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">提交认证</button>
    </view>

    <view class="dev card" wx:if="{{isDev}}">
      <text class="dev-title">开发环境提示</text>
      <text class="dev-text">本地联调填写任意姓名与 4 位数字即可通过，无需真实证件。</text>
    </view>
  </block>
</view>
