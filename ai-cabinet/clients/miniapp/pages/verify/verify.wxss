.container { padding: 24rpx; padding-bottom: 120rpx; min-height: 100vh; background: #f5f6f8; }

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.loading { text-align: center; color: #999; padding: 80rpx 0; }

.hero { padding: 32rpx; }
.title { display: block; font-size: 40rpx; font-weight: 600; margin-bottom: 12rpx; }
.hint { display: block; color: #666; font-size: 26rpx; line-height: 1.6; }

.steps { padding: 24rpx 32rpx; }
.step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.step:last-child { margin-bottom: 0; }
.num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e6f4ff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.form { padding: 32rpx; }
.field { margin-bottom: 24rpx; }
.label { display: block; color: #333; margin-bottom: 8rpx; font-size: 28rpx; }
.input { background: #f5f5f5; border-radius: 12rpx; padding: 20rpx 24rpx; }
.privacy { display: block; font-size: 22rpx; color: #999; margin-bottom: 24rpx; line-height: 1.5; }

.dev { padding: 24rpx 32rpx; background: #fffbe6; border: 1px solid #ffe58f; }
.dev-title { display: block; font-size: 26rpx; font-weight: 600; color: #d48806; margin-bottom: 8rpx; }
.dev-text { display: block; font-size: 24rpx; color: #8c8c8c; line-height: 1.5; }

.success-card { padding: 48rpx 32rpx; text-align: center; margin-top: 40rpx; }
.success-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #f6ffed;
  color: #52c41a;
  font-size: 48rpx;
  font-weight: 700;
}
.success-title { display: block; font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.success-desc { display: block; color: #666; font-size: 26rpx; margin-bottom: 32rpx; }
.ghost { margin-top: 16rpx; background: #fff; color: #666; }
