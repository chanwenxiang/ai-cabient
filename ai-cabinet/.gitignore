# .gitignore

target/
*.class
*.jar
.idea/
*.iml
.vscode/
.DS_Store

# Python
__pycache__/
.venv/
venv/
*.egg-info/
vision-service/cache/
vision-service/*.pt
vision-service/models/*.pt

# Local env
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
*.log

# Node (frontends)
node_modules/
clients/*/node_modules/
clients/*/dist/
packages/*/dist/
.pnpm-store/
project.private.config.json

# Android/Gradle local build state
edge/android-app/.gradle/
edge/android-app/build/

# Local generated media used during manual tests
scripts/_test_video*.mp4
testdata/*.mp4

# MQTT file persistence
data/mqtt-paho/

# Eclipse Paho MQTT file persistence (legacy)
sim-*-tcplocalhost*/
device-service-*-tcplocalhost*/
