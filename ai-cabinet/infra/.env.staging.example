# 预发环境模板 — 用于 deploy-staging.ps1
# 复制：copy .env.staging.example .env.staging  然后按需改域名/密钥
#
# 与生产对齐的三项：
#   1) AICABINET_MOCK_ENABLED=false + VISION_MOCK_ENABLED=false
#   2) 购物 E2E 走 MQTT（deploy-staging.ps1 / e2e-shopping.ps1）
#   3) SMS 验证码入库 + sms-webhook-mock 实链路（非固定 123456）

SPRING_PROFILES_ACTIVE=staging
AICABINET_STAGING_MODE=true
POSTGRES_PASSWORD=aicabinet-staging-pwd-change-me-ok
POSTGRES_PORT=15433

JWT_SECRET=staging-jwt-secret-key-32bytes-minimum-len
INTERNAL_API_KEY=staging-internal-api-key-32bytes-min
VISION_API_KEY=staging-vision-api-key-32bytes-minimum

AICABINET_MOCK_ENABLED=false
VISION_MOCK_ENABLED=false
RECON_MOCK_ENABLED=false

PUBLIC_BASE_URL=http://localhost
WECHAT_NOTIFY_URL=http://localhost/api/v2/payment/wechat/notify
CORS_ORIGIN=http://localhost
SMS_WEBHOOK_URL=http://localhost:8099/send

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_AUTO_FETCH=true
WECHAT_MINIAPP_ID=
WECHAT_MINIAPP_SECRET=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-staging-change-me
MINIO_BUCKET=cabinet-videos

MQTT_BROKER=tcp://emqx:1883
EMQX_ALLOW_ANONYMOUS=true
EMQX_MQTT_PORT=11883
EMQX_MQTT_TLS_PORT=18883
EMQX_DASHBOARD_PORT=28083

RECOGNIZER_BACKEND=yolo
VISION_INSTALL_ML=true
OBJECT_STORAGE_SCHEME=minio
OSS_REGION=cn-shanghai

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
