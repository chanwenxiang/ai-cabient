// 仅 Sonar(dev)：本机直接用 /workspace；正式从 GitHub checkout；容器内直接 mvn
pipeline {
  agent any
  parameters {
    booleanParam(name: 'USE_LOCAL_MOUNT', defaultValue: false, description: '本机：直接用 /workspace，不拷贝')
  }
  environment {
    SONAR_HOST_URL = "${env.SONAR_HOST_URL ?: 'http://sonarqube:9000'}"
    SONAR_TOKEN = credentials('sonar-token')
  }
  stages {
    stage('Source') {
      steps {
        script {
          def useLocal = params.USE_LOCAL_MOUNT?.toString() == 'true' || env.USE_LOCAL_MOUNT == 'true'
          if (useLocal) {
            echo '本机模式：直接使用 /workspace（跳过全仓拷贝）'
            env.BUILD_DIR = '/workspace'
          } else {
            checkout scm
            env.BUILD_DIR = env.WORKSPACE
          }
        }
      }
    }
    stage('Test + Jacoco + Sonar') {
      steps {
        sh '''
          set -e
          BUILD_DIR="${BUILD_DIR:-$PWD}"
          command -v mvn >/dev/null || { echo "ERROR: Jenkins 镜像未安装 Maven"; exit 127; }
          cd "$BUILD_DIR"
          # 跑单测并生成 Jacoco（失败不阻断扫描上报，便于先看到覆盖率数字）
          mvn -B -Dmaven.test.failure.ignore=true test jacoco:report \
            -pl services/trade-service,services/device-service,services/common/common-core -am
          # 与 sonar-project.properties 对齐：压制 uni-app rpx / Lombok 实体误报
          mvn -B -DskipTests sonar:sonar \
            -Dsonar.projectKey=ai-cabinet-dev \
            -Dsonar.projectName="AI Cabinet (dev)" \
            -Dsonar.host.url="$SONAR_HOST_URL" \
            -Dsonar.token="$SONAR_TOKEN" \
            -Dsonar.coverage.jacoco.xmlReportPaths=**/target/site/jacoco/jacoco.xml \
            -Dsonar.issue.ignore.multicriteria=rpxUnit,lombokEntityField \
            -Dsonar.issue.ignore.multicriteria.rpxUnit.ruleKey=css:S4653 \
            -Dsonar.issue.ignore.multicriteria.rpxUnit.resourceKey='**/*' \
            -Dsonar.issue.ignore.multicriteria.lombokEntityField.ruleKey=java:S1068 \
            -Dsonar.issue.ignore.multicriteria.lombokEntityField.resourceKey='**/domain/**/*'
        '''
      }
    }
  }
}
